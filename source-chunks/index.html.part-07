editor-page .page-heading h1{font-size:clamp(23px,3vw,34px)}.editor-toolbar{z-index:12;background:var(--bg,#f6f8fa);border-bottom:1px solid var(--line,#dce5ed);flex-wrap:wrap;align-items:center;gap:12px;margin-bottom:20px;padding:16px 0;display:flex;position:sticky;top:70px}.editor-save-state{color:var(--muted);margin-right:auto;font-size:12px}.editor-tabs{flex-wrap:wrap;gap:7px;margin:20px 0;display:flex}.editor-tabs button{font:inherit;border:1px solid var(--line,#dce5ed);background:var(--surface,#fff);color:inherit;border-radius:9px;padding:10px 13px;font-size:13px}.editor-tabs .active{color:#246d9f;background:#e8f3fa;border-color:#9fc1d8}.editor-form-fieldset{border:0;min-width:0;margin:0;padding:0}.editor-fields{gap:22px;display:grid}.editor-item{border:1px solid var(--line,#dce5ed);border-radius:12px;gap:17px;min-width:0;padding:20px;display:grid}.editor-item h3,.editor-item h4{margin:0}.editor-item .section-line{flex-wrap:wrap;gap:15px}.editor-field textarea{resize:vertical;min-height:70px}.editor-sources{border:1px solid var(--line,#dce5ed);border-radius:9px;gap:10px;min-width:0;padding:15px;display:grid}.editor-sources legend{color:var(--muted);padding:0 5px;font-size:12px}.editor-sources label,.editor-check{align-items:flex-start;gap:9px;font-size:13px;line-height:1.6;display:flex}.editor-sources input,.editor-check input{flex-shrink:0;margin-top:4px}.editor-pairs{gap:15px;display:grid}.editor-pair{border:1px solid var(--line,#dce5ed);border-radius:10px;gap:12px;padding:15px;display:grid}.editor-two-columns,.editor-edge{grid-template-columns:repeat(2,minmax(0,1fr));gap:15px;display:grid}.editor-edge{background:var(--bg,#f6f8fa);border-radius:10px;padding:14px}.editor-edge>.text-link{grid-column:1/-1}.editor-table-scroll{max-width:100%;overflow:auto}.editor-table-scroll table{border-collapse:collapse;width:100%}.editor-table-scroll td,.editor-table-scroll th{border:1px solid var(--line,#dce5ed);vertical-align:top;min-width:190px;padding:6px}.editor-inline-actions{flex-wrap:wrap;align-items:center;gap:12px;display:flex}.editor-body{align-items:flex-start;gap:20px;display:flex}.editor-workspace{flex:1;min-width:0}.editor-preview{width:min(50%,700px);min-width:0;max-height:78vh;position:sticky;top:155px;overflow:auto}.editor-preview p{white-space:pre-wrap;line-height:1.8}.editor-preview .clinical-flow-svg{min-width:580px}.editor-preview .flow-toolbar{flex-wrap:wrap}.editor-image-preview{object-fit:contain;max-width:100%;height:auto;max-height:500px;margin:12px auto;display:block}.editor-validation{color:#755b24;background:#fff8e9;border:1px solid #e6d4a4;border-radius:10px;margin:16px 0;padding:15px 18px;font-size:13px;line-height:1.7}.editor-validation summary{cursor:pointer;font-weight:600}.editor-revision{border-bottom:1px solid var(--line,#dce5ed);padding:17px 0}.editor-revision h3{margin:8px 0}.editor-revision p{color:var(--muted);font-size:13px;line-height:1.7}.editorial-global-error{color:#963f30;background:#fff0ed;padding:8px 20px;font-size:12px}@media(max-width:950px){.editor-body{display:block}.editor-preview{width:100%;max-height:none;position:static}.editor-toolbar{top:65px}.editor-two-columns,.editor-edge{grid-template-columns:1fr}}@media(max-width:650px){.team-top-link span{display:none}.team-members article,.team-account{flex-direction:column;align-items:flex-start}.team-members label{width:100%}.editor-item{padding:14px}.editor-workspace{padding:15px!important}.editor-toolbar{position:static}.editor-tabs{gap:5px}.editor-tabs button{padding:9px;font-size:12px}.editor-save-state{width:100%}.editor-page .button{font-size:12px}}.auth-panel{max-width:660px}.auth-feedback:focus{outline:none}.auth-feedback:focus-visible{outline:2px solid var(--accent);outline-offset:6px}.auth-feedback:empty,.auth-panel:has(.auth-feedback:empty):not(:has(form)){display:none}.auth-panel .editorial-error,.auth-panel .editorial-status{margin:0 0 20px}.auth-panel .editorial-error p{margin-bottom:0}.auth-confirmation{text-align:left}.auth-mail-icon{background:var(--accent-soft,#e9f4f2);width:64px;height:64px;color:var(--accent,#0f766e);border-radius:18px;place-items:center;margin-bottom:18px;font-size:32px;display:grid}.auth-email{overflow-wrap:anywhere;margin:12px 0 22px;font-size:19px;display:block}.auth-confirmation ol{padding-left:24px;line-height:1.7}.auth-confirmation li{padding:5px 0}.auth-actions{flex-wrap:wrap;align-items:center;gap:12px;margin-top:24px;display:flex}.auth-panel fieldset{gap:18px;display:grid}.auth-panel input[aria-invalid=true]{border-color:#c34242}.auth-field-error{color:#bc3030;font-weight:600}.auth-show-password{align-items:center;font-size:14px;flex-direction:row!important;gap:10px!important;display:flex!important}.auth-show-password input{height:18px;width:18px!important}.auth-submit{min-height:48px}.auth-panel .flow-view-toggle{margin:20px 0}.auth-panel[aria-busy=true] .auth-submit{cursor:wait}@media(max-width:650px){.auth-actions{flex-direction:column;align-items:stretch}.auth-panel{padding:22px}.auth-confirmation h2{font-size:25px}}
</style>
</head><body><div id="root"><style>
.av-guide{color:#203249;font:inherit;margin:24px 0;min-width:0}.av-guide *{box-sizing:border-box}.av-panel{background:#fff;border:1px solid #dfe7ef;border-radius:22px;padding:26px;margin:20px 0;scroll-margin-top:90px}.av-panel h2{margin:0 0 9px;font-size:clamp(22px,3vw,29px);color:#152c45;line-height:1.35}.av-sub{color:#64748b;margin:0 0 22px;line-height:1.6}.av-tag{display:inline-block;color:#107b70;background:#e4f5f1;border-radius:8px;padding:4px 10px;margin-right:10px;font-size:15px;vertical-align:middle}.av-pat-grid{display:grid;grid-template-columns:minmax(240px,.8fr) minmax(0,1.2fr);gap:26px;align-items:center}.av-triangle{margin:0;min-width:0;text-align:center}.av-triangle svg{display:block;width:100%;max-width:390px;height:auto;margin:auto}.av-triangle figcaption{font-size:14px;color:#64748b;line-height:1.5}.av-domains{display:grid;gap:14px}.av-domain{padding:18px 20px;border-radius:15px;border-left:4px solid var(--av-color);background:var(--av-bg)}.av-domain h3{font-size:20px;color:var(--av-color);margin:0 0 8px;line-height:1.4}.av-domain p,.av-points p{margin:4px 0;line-height:1.65}.av-appearance{--av-color:#4966c3;--av-bg:#eef1fd}.av-breathing{--av-color:#107f78;--av-bg:#eaf7f5}.av-circulation{--av-color:#a7621c;--av-bg:#fff5e9}.av-steps{list-style:none!important;margin:0!important;padding:0!important;display:grid;gap:12px}.av-step{display:grid;grid-template-columns:64px minmax(180px,.9fr) minmax(0,1.3fr);gap:18px;align-items:center;background:var(--av-bg);padding:18px;border-radius:16px;margin:0!important}.av-letter{display:grid;place-items:center;width:64px;height:64px;border-radius:14px;background:var(--av-color);color:white;font-size:38px;font-weight:750;line-height:1}.av-name h3{font-size:21px;line-height:1.4;margin:0 0 5px;color:#203249}.av-name small{font-size:15px;color:var(--av-color)}.av-points{font-size:16px;min-width:0}.av-a{--av-color:#4265c5;--av-bg:#edf1fd}.av-b{--av-color:#087f85;--av-bg:#e9f7f7}.av-c{--av-color:#b26620;--av-bg:#fff4e6}.av-d{--av-color:#8054b9;--av-bg:#f4eefc}.av-e{--av-color:#a34c6c;--av-bg:#fbedf3}.av-urgent{padding:20px 24px;border-radius:17px;background:#153e4a;color:#fff;margin-top:22px;line-height:1.65}.av-urgent strong{display:block;font-size:20px;margin-bottom:5px}.av-urgent p{margin:0;color:#d2e7e9}.av-foot{font-size:14px;color:#64748b;line-height:1.6}.av-nav{display:flex;flex-wrap:wrap;gap:10px;margin-bottom:18px}.av-nav a{padding:9px 16px;border:1px solid #dfe7ef;border-radius:10px;text-decoration:none;color:#176b78;background:#fff}.av-nav a:hover{background:#eaf7f5}.av-nav a:focus-visible{outline:3px solid #087f85;outline-offset:3px}
@media(max-width:1000px){.av-step{grid-template-columns:58px minmax(0,1fr)}.av-letter{width:58px;height:58px}.av-points{grid-column:2}.av-pat-grid{grid-template-columns:1fr}.av-triangle svg{max-width:330px}}
@media(max-width:520px){.av-panel{padding:18px 14px;border-radius:17px}.av-step{padding:14px;gap:10px 13px;grid-template-columns:48px minmax(0,1fr)}.av-letter{width:48px;height:48px;font-size:30px;border-radius:11px}.av-name h3{font-size:18px}.av-points{grid-column:1/-1;font-size:16px}.av-domain{padding:15px}.av-domain h3{font-size:19px}.av-urgent{padding:18px}.av-urgent strong{font-size:18px}.av-guide{margin:18px 0}}
@media print{.av-nav{display:none}.av-panel{break-inside:avoid}.av-step,.av-domain{break-inside:avoid} .av-guide{-webkit-print-color-adjust:exact;print-color-adjust:exact}}

.readable-image-slot{border:1px dashed #a7bdcc;border-radius:12px;background:#f5f9fc;padding:25px;margin:20px 0;text-align:center;color:#627b8e;min-height:150px;display:flex;flex-direction:column;justify-content:center}.readable-image-slot p{margin-bottom:0}.readable-handbook{max-width:1120px;margin:auto;padding:28px 24px 70px;color:#24394d;font:16px/1.75 Arial,sans-serif;background:#f6f8fa}.readable-handbook a{color:#246d9f;text-decoration:underline;text-underline-offset:3px}.readable-handbook h1{font-size:28px;line-height:1.4;margin:14px 0}.readable-handbook h2{font-size:21px;margin:15px 0;color:#142e44}.readable-handbook h3{font-size:17px;line-height:1.6;margin:18px 0 8px}.readable-handbook p{margin:9px 0 13px}.readable-brand{font-size:24px;font-weight:700;color:#153d58}.readable-kicker{font-size:12px;letter-spacing:.08em;color:#2877ae;margin-top:22px!important}.readable-cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:13px;margin:23px 0}.readable-card{display:flex;flex-direction:column;gap:5px;border:1px solid #dce5ed;border-radius:10px;background:white;padding:18px;text-decoration:none!important}.readable-card>span,.readable-card>small{color:#657b8e;font-size:13px}.readable-article{padding-top:40px;margin-top:35px;border-top:2px solid #2877ae;scroll-margin-top:15px}.readable-outline{display:flex;flex-wrap:wrap;gap:8px 18px;font-size:14px;padding:17px;background:white;border:1px solid #dce5ed;border-radius:8px;margin:19px 0}.readable-summary{padding:18px;background:#edf5fb;border-left:3px solid #2877ae;border-radius:7px}.readable-section{padding-top:24px;scroll-margin-top:15px}.readable-section>h2{border-bottom:1px solid #dce5ed;padding-bottom:10px}.readable-section>h2>span{color:#2877ae;font-size:13px}.readable-block{background:white;border:1px solid #dce5ed;border-radius:8px;padding:15px 18px;margin:12px 0}.readable-block h3{margin-top:0}.readable-danger{background:#fff2ef;border-left:3px solid #b76859}.readable-table{background:white;border:1px solid #dce5ed;border-radius:8px;padding:14px;margin:14px 0}.readable-scroll{overflow:auto}.readable-handbook table{border-collapse:collapse;width:100%;font-size:14px;line-height:1.7}.readable-handbook th,.readable-handbook td{padding:12px;min-width:145px;text-align:left;vertical-align:top;border:1px solid #dce5ed}.readable-handbook thead{background:#edf5fb}.readable-handbook li{margin:10px 0 20px}.readable-transition{color:#2877ae;font-size:14px}.readable-handbook summary{cursor:pointer;margin:18px 0;font-weight:600}.readable-hint{font-size:13px;color:#657b8e}.readable-manual-links{display:flex;flex-wrap:wrap;gap:17px;margin:16px 0}
@media(max-width:650px){.readable-handbook{padding:20px 16px}.readable-cards{grid-template-columns:1fr}.readable-handbook h1{font-size:24px}.readable-handbook h2{font-size:19px}.readable-outline{gap:8px 13px;font-size:13px}.readable-block{padding:13px}}
@media print{.readable-cards,.readable-outline,.readable-manual-links{display:none}.readable-handbook{padding:0;max-width:none}.readable-article{break-before:page}.readable-section h2{break-after:avoid}}
</style><main class="readable-handbook" aria-label="Неотложка+ — содержание"><header id="/system/respiratory?age=pediatric"><div class="readable-brand">Неотложка+</div><p class="readable-kicker">КЛИНИЧЕСКАЯ МЕТОДИЧКА · ВЕРСИЯ 0.6.6</p><h1>Дыхательная система</h1><p>Клиническая картина, оценка тяжести, неотложная помощь, диагностика и маршрутизация.</p><p class="readable-hint">Поиск по странице — Ctrl+F или ⌘F.</p><div aria-label="Дыхательные темы"><section ><h2>Дети и новорождённые</h2><h3>Критические состояния</h3><nav class="readable-cards"><a class="readable-card" href="#/protocol/epiglottitis"><strong>Эпиглоттит</strong><span>Epiglottitis</span><small>9 разделов · алгоритм · 2 места для изображений</small></a><a class="readable-card" href="#/protocol/foreign-body"><strong>Инородное тело дыхательных путей</strong><span>Airway foreign body</span><small>9 разделов · алгоритм · 2 места для изображений</small></a><a class="readable-card" href="#/protocol/central-hypoventilation"><strong>Центральная гиповентиляция</strong><span>Central hypoventilation</span><small>9 разделов · алгоритм · 2 места для изображений</small></a></nav><h3>Бронхиальная обструкция и астма</h3><nav class="readable-cards"><a class="readable-card" href="#/protocol/croup"><strong>Круп</strong><span>Croup</span><small>9 разделов · алгоритм · 2 места для изображений</small></a><a class="readable-card" href="#/protocol/acute-asthma"><strong>Острый приступ бронхиальной астмы</strong><span>Acute asthma</span><small>9 разделов · алгоритм · 2 места для изображений</small></a></nav><h3>Инфекции</h3><nav class="readable-cards"><a class="readable-card" href="#/protocol/severe-pneumonia"><strong>Тяжёлая пневмония</strong><span>Severe pneumonia</span><small>9 разделов · алгоритм · 2 места для изображений</small></a><a class="readable-card" href="#/protocol/bronchiolitis"><strong>Бронхиолит</strong><span>Bronchiolitis</span><small>9 разделов · алгоритм · 2 места для изображений</small></a></nav></section><section id="/system/respiratory?age=adult"><h2>Взрослые</h2></section></div><nav class="readable-manual-links" aria-label="Первичная оценка и реанимация"><a href="#/assessment">Первичная оценка</a><a href="#/protocol/pat">PAT</a><a href="#/protocol/abcde">ABCDE</a><a href="#/protocol/pediatric-bls">Pediatric BLS</a><a href="#/protocol/pals">PALS</a></nav></header><section id="/assessment" class="readable-article"><h1>Первичная оценка ребёнка</h1><nav class="av-nav"><a href="#/protocol/pat">PAT</a><a href="#/protocol/abcde">ABCDE</a><a href="#/system/respiratory?age=pediatric">Дыхательные темы</a></nav><div id="/protocol/pat"><div class="av-guide"><section class="av-panel" aria-label="PAT — первое впечатление"><h2><span class="av-tag">01</span>PAT · Первое впечатление</h2><p class="av-sub">Визуально и на слух, без оборудования</p><div class="av-pat-grid"><figure class="av-triangle"><svg viewBox="0 0 400 360" role="img" aria-label="Треугольник PAT: внешний вид, работа дыхания, кровообращение по коже"><path d="M200 58L48 300H352Z" fill="#f5f9fd" stroke="#dfe7ef"/><path d="M200 58L48 300" stroke="#5776d6" stroke-width="11" stroke-linecap="round"/><path d="M200 58L352 300" stroke="#13978e" stroke-width="11" stroke-linecap="round"/><path d="M48 300H352" stroke="#d38130" stroke-width="11" stroke-linecap="round"/><g fill="white" stroke-width="4"><circle cx="200" cy="58" r="11" stroke="#5776d6"/><circle cx="48" cy="300" r="11" stroke="#d38130"/><circle cx="352" cy="300" r="11" stroke="#13978e"/></g><g font-family="Arial,sans-serif" text-anchor="middle"><text x="200" y="35" font-size="21" font-weight="700" fill="#4966c3">Внешний вид</text><text x="200" y="188" font-size="43" font-weight="700" fill="#152c45">PAT</text><text x="200" y="218" font-size="17" fill="#64748b">Оценка с порога</text><text x="320" y="178" font-size="17" fill="#107f78" transform="rotate(58 320 178)">Работа дыхания</text><text x="200" y="334" font-size="18" fill="#a7621c">Кровообращение по коже</text></g></svg><figcaption>Три компонента оцениваются вместе</figcaption></figure><div class="av-domains"><div class="av-domain av-appearance"><h3>Внешний вид</h3><p>Тонус · контакт · утешаемость</p><p>Взгляд · речь или плач</p></div><div class="av-domain av-breathing"><h3>Работа дыхания</h3><p>Втяжения · поза · раздувание крыльев носа</p><p>Патологические дыхательные шумы</p></div><div class="av-domain av-circulation"><h3>Кровообращение по коже</h3><p>Бледность · мраморность · цианоз</p></div></div></div></section><aside class="av-urgent"><strong>Угроза жизни выявлена — действуйте сразу</strong><p>Позовите помощь. Не откладывайте вмешательство до завершения всего осмотра.</p></aside><p class="av-foot">PAT помогает сформировать первое впечатление; ABCDE — системно оценить ребёнка.</p></div></div><div id="/protocol/abcde"><div class="av-guide"><section class="av-panel" aria-label="ABCDE — первичный осмотр"><h2><span class="av-tag">02</span>ABCDE · Первичный осмотр</h2><p class="av-sub">На каждом этапе: оценка → необходимая помощь → повторная оценка</p><ol class="av-steps"><li class="av-step av-a"><span class="av-letter" aria-hidden="true">A</span><div class="av-name"><h3>A · Дыхательные пути</h3><small lang="en">Airway</small></div><div class="av-points"><p>Проходимость · голос или плач</p><p>Стридор · признаки обструкции</p></div></li><li class="av-step av-b"><span class="av-letter" aria-hidden="true">B</span><div class="av-name"><h3>B · Дыхание</h3><small lang="en">Breathing</small></div><div class="av-points"><p>Частота и работа дыхания · экскурсия грудной клетки</p><p>Аускультация · SpO₂</p></div></li><li class="av-step av-c"><span class="av-letter" aria-hidden="true">C</span><div class="av-name"><h3>C · Кровообращение</h3><small lang="en">Circulation</small></div><div class="av-points"><p>Пульс · капиллярное наполнение · температура кожи</p><p>Артериальное давление · кровотечение</p></div></li><li class="av-step av-d"><span class="av-letter" aria-hidden="true">D</span><div class="av-name"><h3>D · Неврологический статус</h3><small lang="en">Disability</small></div><div class="av-points"><p>Сознание по AVPU · зрачки · судороги</p><p>Глюкоза крови</p></div></li><li class="av-step av-e"><span class="av-letter" aria-hidden="true">E</span><div class="av-name"><h3>E · Обстоятельства</h3><small lang="en">Exposure</small></div><div class="av-points"><p>Сыпь · травмы · температура тела</p><p>Предотвращение переохлаждения</p></div></li></ol></section><aside class="av-urgent"><strong>Угроза жизни выявлена — действуйте сразу</strong><p>Позовите помощь. Не откладывайте вмешательство до завершения всего осмотра.</p></aside><p class="av-foot">PAT помогает сформировать первое впечатление; ABCDE — системно оценить ребёнка.</p></div></div></section><article id="/protocol/severe-pneumonia" class="readable-article"><a href="#/system/respiratory?age=pediatric">← Все дыхательные темы</a><p class="readable-kicker">ПЕДИАТРИЯ · ДЫХАТЕЛЬНАЯ СИСТЕМА</p><h1>Тяжёлая пневмония</h1><p>Severe pneumonia</p><nav class="readable-outline" aria-label="Тяжёлая пневмония — оглавление"><a href="#/protocol/severe-pneumonia?section=algorithm">Клинический алгоритм</a><a href="#/protocol/severe-pneumonia?section=clinical">Клиническая картина</a><a href="#/protocol/severe-pneumonia?section=severity">Оценка тяжести</a><a href="#/protocol/severe-pneumonia?section=emergency">Неотложная помощь</a><a href="#/protocol/severe-pneumonia?section=escalation">Эскалация помощи</a><a href="#/protocol/severe-pneumonia?section=diagnostics">Экстренная диагностика</a><a href="#/protocol/severe-pneumonia?section=routing">Маршрутизация</a><a href="#/protocol/severe-pneumonia?section=case">Клинический случай</a><a href="#/protocol/severe-pneumonia?section=references">Клинические рекомендации</a></nav><div class="readable-summary"><strong>Главное за минуту</strong><p>При выраженной работе дыхания, гипоксемии, нарушении сознания или шоке стабилизацию начинают сразу. Тяжёлое течение требует стационарной оценки.</p></div><p>Дети с внебольничной пневмонией. Таблица внутривенного антибиотика относится к возрасту от 3 месяцев до 17 лет. У детей младше 3 месяцев требуется отдельная оценка тяжёлой инфекции.</p><section id="/protocol/severe-pneumonia?section=algorithm" class="readable-section"><h2><span>01</span> Клинический алгоритм</h2><div class="readable-scroll"><svg viewBox="0 0 720 725" role="img" aria-label="Тяжёлая пневмония — алгоритм" style="width:100%;min-width:580px;max-width:800px"><defs><marker id="readable-arrow-severe-pneumonia" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0 0L6 3L0 6" fill="none" stroke="#52748c"/></marker></defs><path d="M360 80V112.5H360V140" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-severe-pneumonia)"/><path d="M360 205V250H170V290" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-severe-pneumonia)"/><text x="265" y="240" text-anchor="middle" font-size="11">Да</text><path d="M360 205V250H550V290" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-severe-pneumonia)"/><text x="455" y="240" text-anchor="middle" font-size="11">Нет</text><path d="M170 355V405H360V450" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-severe-pneumonia)"/><path d="M550 355V405H360V450" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-severe-pneumonia)"/><path d="M360 515V570H550V620" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-severe-pneumonia)"/><text x="455" y="560" text-anchor="middle" font-size="11">Да</text><path d="M360 515V570H170V620" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-severe-pneumonia)"/><text x="265" y="560" text-anchor="middle" font-size="11">Нет / хуже</text><g><rect x="255" y="20" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="360" y="44" text-anchor="middle" font-size="12">Кашель / лихорадка</text><text x="360" y="60" text-anchor="middle" font-size="12">+ дыхательные нарушения</text></g><g><rect x="255" y="145" width="210" height="60" rx="17" fill="#edf5fb" stroke="#467495"/><text x="360" y="169" text-anchor="middle" font-size="12">Апноэ / истощение /</text><text x="360" y="185" text-anchor="middle" font-size="12">сознание / шок?</text></g><g><rect x="65" y="295" width="210" height="60" rx="7" fill="#fff0ed" stroke="#467495"/><text x="170" y="319" text-anchor="middle" font-size="12">Команда + кислород</text><text x="170" y="335" text-anchor="middle" font-size="12">Вентиляция по состоянию</text></g><g><rect x="445" y="295" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="550" y="319" text-anchor="middle" font-size="12">Оценить тяжесть</text><text x="550" y="335" text-anchor="middle" font-size="12">и осложнения</text></g><g><rect x="255" y="455" width="210" height="60" rx="17" fill="#edf5fb" stroke="#467495"/><text x="360" y="479" text-anchor="middle" font-size="12">Ответ и оксигенация</text><text x="360" y="495" text-anchor="middle" font-size="12">достаточны?</text></g><g><rect x="65" y="625" width="210" height="60" rx="7" fill="#fff0ed" stroke="#467495"/><text x="170" y="649" text-anchor="middle" font-size="12">ОРИТ / респираторная</text><text x="170" y="665" text-anchor="middle" font-size="12">поддержка</text></g><g><rect x="445" y="625" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="550" y="649" text-anchor="middle" font-size="12">Стационар и контроль</text><text x="550" y="665" text-anchor="middle" font-size="12">ответа на лечение</text></g></svg></div><h3>Действия и условия перехода</h3><ol class="readable-steps"><li><h3>Кашель / лихорадка + дыхательные нарушения</h3><p>Оценить дыхание, оксигенацию, сознание и перфузию.</p><p class="readable-transition">→ Апноэ / истощение / сознание / шок?</p></li><li><h3>Апноэ / истощение / сознание / шок?</h3><p>При угрозе жизни стабилизация идёт параллельно обследованию.</p><p class="readable-transition">Да → Команда + кислород Вентиляция по состоянию<br>Нет → Оценить тяжесть и осложнения</p></li><li><h3>Команда + кислород Вентиляция по состоянию</h3><p>Оценить сепсис и необходимость ОРИТ.</p><p class="readable-transition">→ Ответ и оксигенация достаточны?</p></li><li><h3>Оценить тяжесть и осложнения</h3><p>Начать поддержку и лечение по тяжести и возрасту.</p><p class="readable-transition">→ Ответ и оксигенация достаточны?</p></li><li><h3>Ответ и оксигенация достаточны?</h3><p>При ухудшении немедленно пересмотреть поддержку и поиск осложнений.</p><p class="readable-transition">Да → Стационар и контроль ответа на лечение<br>Нет / хуже → ОРИТ / респираторная поддержка</p></li><li><h3>ОРИТ / респираторная поддержка</h3><p>Согласовать дальнейшую поддержку, диагностику и перевод.</p></li><li><h3>Стационар и контроль ответа на лечение</h3><p>При улучшении пересмотреть IV-путь и план выписки.</p></li></ol></section><section id="/protocol/severe-pneumonia?section=clinical" class="readable-section"><h2><span>02</span> Клиническая картина</h2><p>Лихорадка и кашель сочетаются с тахипноэ в покое, втяжениями, стонущим дыханием или фокальными аускультативными признаками. Одностороннее ослабление дыхания с притуплением требует оценки плеврального выпота.</p><div class="readable-block readable-danger"><h3>Признаки непосредственной угрозы</h3><p>Апноэ, истощение, цианоз, нарушение сознания и признаки шока требуют немедленного вызова реанимационной команды. Оценить дыхание и перфузию, начать поддержку и параллельно оценить вероятность сепсиса.</p></div><figure class="readable-image-slot"><strong>Место для изображения 1</strong><p>Рентгенограмма пневмонии у ребёнка</p></figure></section><section id="/protocol/severe-pneumonia?section=severity" class="readable-section"><h2><span>03</span> Оценка тяжести</h2><div class="readable-table"><h3>Клинические признаки тяжести</h3><div class="readable-scroll" tabindex="0"><table><thead><tr><th scope="col">Состояние</th><th scope="col">Ориентиры</th></tr></thead><tbody><tr><th scope="row">Тяжёлая пневмония</th><td>Выраженное дыхательное усилие, гипоксемия, выраженная системная тяжесть или осложнения.</td></tr><tr><th scope="row">Жизнеугрожающее течение</th><td>Апноэ, неэффективная вентиляция, изменённое сознание или шок.</td></tr><tr><th scope="row">Осложнённая пневмония</th><td>Выпот, эмпиема, абсцесс или некротизирующее течение.</td></tr></tbody></table></div></div></section><section id="/protocol/severe-pneumonia?section=emergency" class="readable-section"><h2><span>04</span> Неотложная помощь</h2><div class="readable-block "><h3>Первичная оценка</h3><p>Оценить ЧДД в покое, втяжения, стонущее дыхание, SpO₂, уровень сознания, перфузию и возможность пить. Уточнить возраст, сопутствующие болезни, предшествующие антибиотики и аллергию.</p></div><div class="readable-block "><h3>Оксигенация и начало лечения</h3><p>При стойкой SpO₂ ниже 90% RCH рекомендует кислород. При неэффективном дыхании помощь определяют по клинике. При предполагаемой тяжёлой бактериальной пневмонии начать антибиотик с учётом тяжести, пути введения и локальной чувствительности. При нарушении питания и питья оценить потребность в поддержке гидратации.</p></div><div class="readable-table"><h3>Парентеральная схема при тяжёлой пневмонии по NICE</h3><div class="readable-scroll" tabindex="0"><table><thead><tr><th scope="col">Возраст и показание</th><th scope="col">Доза и путь</th><th scope="col">Контроль</th></tr></thead><tbody><tr><th scope="row">3 месяца–17 лет. Тяжёлая внебольничная пневмония, требуется IV-путь</th><td>Амоксициллин/клавуланат 30 мг/кг/дозу по сумме компонентов IV каждые 8 ч. Максимум 1,2 г на дозу</td><td>Проверить аллергию, функцию почек и локальные рекомендации. При сепсисе и осложнениях требуется отдельный выбор схемы.</td></tr><tr><th scope="row">Переоценка</th><td>Пересмотреть IV-путь в течение 48 ч</td><td>Курс NICE обычно 5 дней. При нестабильности или осложнениях длительность определяют индивидуально.</td></tr></tbody></table></div></div><h3>Повторная оценка</h3><p>Оценивать работу дыхания, SpO₂ и потребность в кислороде, сознание, перфузию и диурез. При ухудшении немедленно пересмотреть тактику. Отсутствие улучшения через 48–72 часа требует оценки осложнений и пересмотра лечения.</p></section><section id="/protocol/severe-pneumonia?section=escalation" class="readable-section"><h2><span>05</span> Эскалация помощи</h2><p>Нарастающая кислородная потребность, неэффективная вентиляция, изменённое сознание или шок требуют привлечения ОРИТ. При выпоте или эмпиеме обсудить необходимость дополнительных вмешательств с профильной командой.</p></section><section id="/protocol/severe-pneumonia?section=diagnostics" class="readable-section"><h2><span>06</span> Экстренная диагностика</h2><div class="readable-block "><h3>Обследования при тяжёлом течении</h3><p>Рентгенография показана при тяжёлом или осложнённом течении после начала стабилизации. По клинической задаче оценить общий анализ крови, электролиты и посев крови. При подозрении на выпот уточнить его наличие и характеристики. CRP и прокальцитонин сами по себе не разделяют вирусную и бактериальную этиологию.</p></div><div class="readable-table"><h3>Механизмы и дифференциальная диагностика</h3><div class="readable-scroll" tabindex="0"><table><thead><tr><th scope="col">Состояние</th><th scope="col">Ориентиры</th></tr></thead><tbody><tr><th scope="row">Бронхиолит / астма</th><td>Преимущественно свистящая обструкция и характерный возраст или анамнез.</td></tr><tr><th scope="row">Инородное тело</th><td>Внезапное начало или рецидив в одной доле.</td></tr><tr><th scope="row">Пневмоторакс / плевральное осложнение</th><td>Острое ухудшение и асимметрия дыхания.</td></tr></tbody></table></div></div><figure class="readable-image-slot"><strong>Место для изображения 2</strong><p>УЗИ парапневмонического выпота</p></figure></section><section id="/protocol/severe-pneumonia?section=routing" class="readable-section"><h2><span>07</span> Маршрутизация</h2><div class="readable-block "><h3>Госпитализация</h3><p>Потребность в кислороде, среднетяжёлая или тяжёлая работа дыхания, необходимость зондовой или внутривенной гидратации и осложнения требуют стационарной помощи. При нарастающей респираторной поддержке или шоке привлекают ОРИТ.</p></div><div class="readable-block "><h3>Пересмотр лечения и выписка</h3><p>Внутривенную терапию пересмотреть в течение 48 часов и при клинической возможности перейти на приём внутрь. Оценить устойчивую оксигенацию без кислорода, восстановление питья и план дальнейшего лечения.</p></div></section><section id="/protocol/severe-pneumonia?section=case" class="readable-section"><h2><span>08</span> Клинический случай</h2><h3>Учебный сценарий</h3><p>Ребёнок 4 лет с лихорадкой и кашлем. Выраженные втяжения, вялость, стонущее дыхание и SpO₂ 87%. Справа дыхание заметно ослаблено.</p><h3>Что приоритетно до рентгенографии и что искать?</h3><h3>Разбор и тактика</h3><p>Начать кислород, оценить вентиляцию и перфузию, привлечь старшего врача. После начала стабилизации оценить плевральный выпот и другие осложнения. По клинике определить лечение предполагаемой бактериальной пневмонии, сепсиса и потребность в ОРИТ.</p></section><section id="/protocol/severe-pneumonia?section=references" class="readable-section"><h2><span>09</span> Клинические рекомендации</h2><ol><li><strong>Community acquired pneumonia</strong><p>Royal Children’s Hospital Melbourne · Клиническое руководство</p><a href="https://www.rch.org.au/clinicalguide/guideline_index/Community_acquired_pneumonia/" target="_blank" rel="noreferrer">Открыть рекомендацию</a></li><li><strong>Pneumonia: diagnosis and management — NG250</strong><p>NICE · Рекомендации и таблица 2</p><a href="https://www.nice.org.uk/guidance/ng250/chapter/recommendations" target="_blank" rel="noreferrer">Открыть рекомендацию</a></li></ol></section></article><article id="/protocol/croup" class="readable-article"><a href="#/system/respiratory?age=pediatric">← Все дыхательные темы</a><p class="readable-kicker">ПЕДИАТРИЯ · ДЫХАТЕЛЬНАЯ СИСТЕМА</p><h1>Круп</h1><p>Croup</p><nav class="readable-outline" aria-label="Круп — оглавление"><a href="#/protocol/croup?section=algorithm">Клинический алгоритм</a><a href="#/protocol/croup?section=clinical">Клиническая картина</a><a href="#/protocol/croup?section=severity">Оценка тяжести</a><a href="#/protocol/croup?section=emergency">Неотложная помощь</a><a href="#/protocol/croup?section=escalation">Эскалация помощи</a><a href="#/protocol/croup?section=diagnostics">Экстренная диагностика</a><a href="#/protocol/croup?section=routing">Маршрутизация</a><a href="#/protocol/croup?section=case">Клинический случай</a><a href="#/protocol/croup?section=references">Клинические рекомендации</a></nav><div class="readable-summary"><strong>Главное за минуту</strong><p>Минимизировать стресс. Тяжесть определяется воздушным потоком, работой дыхания и сознанием; нормальная SpO₂ не исключает опасную обструкцию.</p></div><p>Типичный вирусный круп у ребёнка. Слюнотечение, токсический вид или внезапное поперхивание требуют поиска другого диагноза.</p><section id="/protocol/croup?section=algorithm" class="readable-section"><h2><span>01</span> Клинический алгоритм</h2><div class="readable-scroll"><svg viewBox="0 0 720 835" role="img" aria-label="Круп — алгоритм" style="width:100%;min-width:580px;max-width:800px"><defs><marker id="readable-arrow-croup" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0 0L6 3L0 6" fill="none" stroke="#52748c"/></marker></defs><path d="M360 80V112.5H360V140" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-croup)"/><path d="M360 205V250H170V290" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-croup)"/><text x="265" y="240" text-anchor="middle" font-size="11">Да</text><path d="M360 205V250H550V290" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-croup)"/><text x="455" y="240" text-anchor="middle" font-size="11">Нет</text><path d="M170 355V377H25V563H170V580" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-croup)"/><path d="M550 355V397.5H170V435" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-croup)"/><text x="360" y="387.5" text-anchor="middle" font-size="11">Да</text><path d="M550 355V397.5H550V435" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-croup)"/><text x="585" y="387.5" text-anchor="middle" font-size="11">Нет</text><path d="M550 500V617.5H550V730" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-croup)"/><path d="M170 500V542.5H170V580" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-croup)"/><path d="M170 645V690H170V730" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-croup)"/><text x="205" y="680" text-anchor="middle" font-size="11">Нет / хуже</text><path d="M170 645V690H550V730" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-croup)"/><text x="360" y="680" text-anchor="middle" font-size="11">Да</text><g><rect x="255" y="20" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="360" y="44" text-anchor="middle" font-size="12">Лающий кашель /</text><text x="360" y="60" text-anchor="middle" font-size="12">осиплость / стридор</text></g><g><rect x="255" y="145" width="210" height="60" rx="17" fill="#edf5fb" stroke="#467495"/><text x="360" y="169" text-anchor="middle" font-size="12">Истощение /</text><text x="360" y="185" text-anchor="middle" font-size="12">плохой поток / сознание?</text></g><g><rect x="65" y="295" width="210" height="60" rx="7" fill="#fff0ed" stroke="#467495"/><text x="170" y="319" text-anchor="middle" font-size="12">Команда + адреналин</text><text x="170" y="335" text-anchor="middle" font-size="12">+ дексаметазон</text></g><g><rect x="445" y="295" width="210" height="60" rx="17" fill="#edf5fb" stroke="#467495"/><text x="550" y="319" text-anchor="middle" font-size="12">Стридор в покое /</text><text x="550" y="335" text-anchor="middle" font-size="12">выраженные втяжения?</text></g><g><rect x="445" y="440" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="550" y="464" text-anchor="middle" font-size="12">Лёгкий круп: комфорт</text><text x="550" y="480" text-anchor="middle" font-size="12">± стероид по показаниям</text></g><g><rect x="65" y="440" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="170" y="464" text-anchor="middle" font-size="12">ГКС; адреналин при</text><text x="170" y="480" text-anchor="middle" font-size="12">стойких / тяжёлых симптомах</text></g><g><rect x="65" y="585" width="210" height="60" rx="17" fill="#edf5fb" stroke="#467495"/><text x="170" y="617" text-anchor="middle" font-size="12">Эффект устойчив?</text></g><g><rect x="65" y="735" width="210" height="60" rx="7" fill="#fff0ed" stroke="#467495"/><text x="170" y="759" text-anchor="middle" font-size="12">ОРИТ / контроль</text><text x="170" y="775" text-anchor="middle" font-size="12">дыхательных путей</text></g><g><rect x="445" y="735" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="550" y="759" text-anchor="middle" font-size="12">Наблюдение; после</text><text x="550" y="775" text-anchor="middle" font-size="12">адреналина ≥3 часов</text></g></svg></div><h3>Действия и условия перехода</h3><ol class="readable-steps"><li><h3>Лающий кашель / осиплость / стридор</h3><p>Положение комфорта, родитель рядом, минимизировать стресс.</p><p class="readable-transition">→ Истощение / плохой поток / сознание?</p></li><li><h3>Истощение / плохой поток / сознание?</h3><p>Тихий стридор при ухудшении и гипоксемия — поздние опасные признаки.</p><p class="readable-transition">Да → Команда + адреналин + дексаметазон<br>Нет → Стридор в покое / выраженные втяжения?</p></li><li><h3>Команда + адреналин + дексаметазон</h3><p>Реанимационная зона; кислород, готовность к сложным дыхательным путям опытной командой.</p><p class="readable-transition">→ Эффект устойчив?</p></li><li><h3>Стридор в покое / выраженные втяжения?</h3><p>Оценить совокупность признаков; громкость стридора не является самостоятельной шкалой.</p><p class="readable-transition">Да → ГКС; адреналин при стойких / тяжёлых симптомах<br>Нет → Лёгкий круп: комфорт ± стероид по показаниям</p></li><li><h3>Лёгкий круп: комфорт ± стероид по показаниям</h3><p>При одном лающем кашле без анамнеза стридора RCH допускает отсутствие стероида; при стридоре/риске рассмотреть дексаметазон.</p><p class="readable-transition">→ Наблюдение; после адреналина ≥3 часов</p></li><li><h3>ГКС; адреналин при стойких / тяжёлых симптомах</h3><p>Дозы и пути введения — в лечебной таблице. При тяжёлом состоянии одновременно вызвать анестезиолога.</p><p class="readable-transition">→ Эффект устойчив?</p></li><li><h3>Эффект устойчив?</h3><p>Недостаточный ответ: повтор адреналина по выбранному протоколу и срочная экспертная оценка.</p><p class="readable-transition">Нет / хуже → ОРИТ / контроль дыхательных путей<br>Да → Наблюдение; после адреналина ≥3 часов</p></li><li><h3>ОРИТ / контроль дыхательных путей</h3><p>Не задерживать помощь ради обследования. Перевод согласовать с принимающей командой.</p></li><li><h3>Наблюдение; после адреналина ≥3 часов</h3><p>При рецидиве вернуться к оценке тяжести. Выписка только без стридора в покое/дистресса и при безопасном питье.</p></li></ol></section><section id="/protocol/croup?section=clinical" class="readable-section"><h2><span>02</span> Клиническая картина</h2><p>Обычно после насморка появляются лающий кашель, осиплость и инспираторный стридор. Круп чаще встречается в возрасте 6 месяцев–6 лет и усиливается ночью. Дисфагия, слюнотечение или токсический вид требуют поиска другого диагноза.</p><div class="readable-block readable-danger"><h3>Тихий стридор может означать ухудшение</h3><p>Слабый воздушный поток, истощение, сонливость, цианоз, апноэ или уменьшающееся дыхательное усилие требуют реанимационной команды и готовности опытного специалиста обеспечить дыхательные пути. Ослабление стридора при ухудшении не считать улучшением.</p></div><div class="readable-block "><h3>Исключить опасную альтернативу</h3><p>Слюнотечение, выраженная дисфагия, поза с наклоном вперёд, высокая лихорадка и токсический вид заставляют думать об эпиглоттите или бактериальном трахеите. Внезапное начало при еде/игре — об инородном теле. Не провоцировать осмотром глотки.</p></div><figure class="readable-image-slot"><strong>Место для изображения 1</strong><p>Схема подсвязочного отёка при крупе</p></figure></section><section id="/protocol/croup?section=severity" class="readable-section"><h2><span>03</span> Оценка тяжести</h2><div class="readable-table"><h3>Клинические признаки тяжести</h3><div class="readable-scroll" tabindex="0"><table><thead><tr><th scope="col">Состояние</th><th scope="col">Ориентиры</th></tr></thead><tbody><tr><th scope="row">Лёгкий</th><td>Стридора в покое нет, втяжения отсутствуют или минимальны.</td></tr><tr><th scope="row">Среднетяжёлый</th><td>Стридор в покое и втяжения при сохранённом контакте и воздушном потоке.</td></tr><tr><th scope="row">Тяжёлый</th><td>Выраженные втяжения, стойкий стридор, возбуждение.</td></tr><tr><th scope="row">Жизнеугрожающий</th><td>Истощение, слабый поток, цианоз или нарушение сознания. Стридор может стать тише.</td></tr></tbody></table></div></div></section><section id="/protocol/croup?section=emergency" class="readable-section"><h2><span>04</span> Неотложная помощь</h2><div class="readable-block "><h3>A/B и поведение — до манипуляций</h3><p>Оставить с родителем в положении комфорта. Оценить стридор в покое, втяжения, поступление воздуха, цвет и контакт. Мониторинг по переносимости: борьба с ребёнком может усугубить обструкцию.</p></div><div class="readable-block "><h3>Тяжёлый или жизнеугрожающий круп</h3><p>Реанимационная зона, старший врач/анестезиолог, небулизированный адреналин и дексаметазон по таблице. Кислород по клинике и переносимости; при жизнеугрожающем состоянии — высокая концентрация. Подготовка к контролируемому обеспечению дыхательных путей идёт параллельно.</p></div><div class="readable-block "><h3>Контроль ответа</h3><p>После адреналина оценить эффект; Queensland допускает повтор через 10 минут при недостаточном ответе и клинические наблюдения каждые 15 минут в первый час. Отсутствие ответа или необходимость повторных доз требуют ранней эскалации. Не ждать эффекта стероида при ухудшении.</p></div><div class="readable-block "><h3>Рутинные назначения, которых следует избегать</h3><p>Антибиотики не нужны при неосложнённом вирусном крупе. Сальбутамол не лечит подскладочный отёк. Паровые ингаляции и седативные/противокашлевые не заменяют лечение обструкции; горячий пар несёт риск ожога.</p></div><div class="readable-table"><h3>Препараты при крупе</h3><div class="readable-scroll" tabindex="0"><table><thead><tr><th scope="col">Препарат / ситуация</th><th scope="col">Доза и путь</th><th scope="col">Ограничение</th></tr></thead><tbody><tr><th scope="row">Дексаметазон: лёгкий с показаниями / среднетяжёлый</th><td>0,15 мг/кг внутрь однократно; максимум 12 мг</td><td>PO предпочтителен. Выбран вариант RCH/Queensland</td></tr><tr><th scope="row">Дексаметазон: тяжёлый / жизнеугрожающий</th><td>0,6 мг/кг однократно; максимум 12 мг; PO/IM/IV по ситуации</td><td>При жизнеугрожающем состоянии путь определяет команда</td></tr><tr><th scope="row">Адреналин: стойкая значимая / тяжёлая обструкция</th><td>1 мг/мл: 5 мл = 5 мг через небулайзер</td><td>Только указанный ингаляционный путь. Не путать со схемой анафилаксии</td></tr><tr><th scope="row">Будесонид: невозможно принять системный ГКС</th><td>2 мг через небулайзер однократно</td><td>Альтернатива; рутинно к принятому дексаметазону не добавлять</td></tr></tbody></table></div><p>Концентрацию и лекарственную форму сверять перед введением. Различия схем стероидов вынесены в замечания.</p></div><h3>Повторная оценка</h3><p>После адреналина повторно оценить стридор, втяжения, воздушный поток и сознание. Ухудшение требует немедленной оценки. После последней ингаляции наблюдать не менее 3 часов.</p></section><section id="/protocol/croup?section=escalation" class="readable-section"><h2><span>05</span> Эскалация помощи</h2><p>Слабый или кратковременный ответ на адреналин, повторная потребность в нём, истощение или снижение сознания требуют старшего врача и раннего привлечения команды дыхательных путей.</p></section><section id="/protocol/croup?section=diagnostics" class="readable-section"><h2><span>06</span> Экстренная диагностика</h2><div class="readable-block "><h3>Обычно диагноз клинический</h3><p>Лающий кашель, осиплость и инспираторный стридор после респираторного продрома типичны для крупа. При обычном течении анализы, мазки и рентгенография не нужны; исследования при альтернативном диагнозе допустимы после оценки безопасности дыхательных путей.</p></div><div class="readable-table"><h3>Механизмы и дифференциальная диагностика</h3><div class="readable-scroll" tabindex="0"><table><thead><tr><th scope="col">Состояние</th><th scope="col">Ориентиры</th></tr></thead><tbody><tr><th scope="row">Эпиглоттит</th><td>Боль при глотании, слюнотечение, приглушённый голос.</td></tr><tr><th scope="row">Бактериальный трахеит</th><td>Токсический вид, лихорадка, плохой ответ на терапию крупа.</td></tr><tr><th scope="row">Инородное тело</th><td>Внезапное поперхивание, асимметрия дыхания.</td></tr></tbody></table></div></div><figure class="readable-image-slot"><strong>Место для изображения 2</strong><p>Примеры стридора и втяжений с пояснениями</p></figure></section><section id="/protocol/croup?section=routing" class="readable-section"><h2><span>07</span> Маршрутизация</h2><div class="readable-block "><h3>Наблюдение и выписка</h3><p>После последнего небулизированного адреналина выбран срок наблюдения не менее 3 часов без рецидива. Для выписки: нет стридора в покое и дистресса, ребёнок бодр и пьёт, семья знает признаки возврата и имеет доступ к помощи. При ночном обращении, риске или удалённости — наблюдать дольше.</p></div><div class="readable-block "><h3>Когда госпитализировать / переводить</h3><p>Повторный адреналин, стойкий стридор в покое, недостаточное питьё, диагностическая неопределённость или отсутствие устойчивого ответа — стационарная оценка. Истощение, нарушенное сознание, гипоксемия и ожидаемая интубация — ОРИТ/центр с детской анестезиологией.</p></div></section><section id="/protocol/croup?section=case" class="readable-section"><h2><span>08</span> Клинический случай</h2><h3>Учебный сценарий</h3><p>Ребёнок 2 лет, 12 кг. После насморка ночью появились лающий кашель и осиплость. Есть стридор в покое и умеренные втяжения. Контакт сохранён, SpO₂ 97%.</p><h3>Как оценить тяжесть при нормальной сатурации?</h3><h3>Разбор и тактика</h3><p>Стридор в покое и втяжения соответствуют среднетяжёлому крупу. По выбранной схеме RCH дексаметазон 0,15 мг/кг внутрь однократно, для 12 кг это 1,8 мг. При сохраняющейся значимой обструкции рассмотреть небулизированный адреналин по таблице и повторно оценить ребёнка.</p></section><section id="/protocol/croup?section=references" class="readable-section"><h2><span>09</span> Клинические рекомендации</h2><ol><li><strong>Croup (Laryngotracheobronchitis)</strong><p>Royal Children’s Hospital Melbourne · Сентябрь 2024</p><a href="https://www.rch.org.au/clinicalguide/guideline_index/Croup_Laryngotracheobronchitis/" target="_blank" rel="noreferrer">Открыть рекомендацию</a></li><li><strong>Croup — Emergency management in children</strong><p>Children’s Health Queensland · Онлайн-редакция; сверка 09.11.2026</p><a href="https://www.childrens.health.qld.gov.au/for-health-professionals/queensland-paediatric-emergency-care-qpec/queensland-paediatric-clinical-guidelines/croup" target="_blank" rel="noreferrer">Открыть рекомендацию</a></li><li><strong>Acute management of croup in the emergency department</strong><p>Canadian Paediatric Society · Обновление 06.03.2026</p><a href="https://cps.ca/en/documents/position/acute-management-of-croup" target="_blank" rel="noreferrer">Открыть рекомендацию</a></li><li><strong>Acute upper airway obstruction</strong><p>Royal Children’s Hospital Melbourne · Онлайн-редакция; год публикации не указан</p><a href="https://www.rch.org.au/clinicalguide/guideline_index/Acute_upper_airway_obstruction/" target="_blank" rel="noreferrer">Открыть рекомендацию</a></li></ol></section></article><article id="/protocol/bronchiolitis" class="readable-article"><a href="#/system/respiratory?age=pediatric">← Все дыхательные темы</a><p class="readable-kicker">ПЕДИАТРИЯ · ДЫХАТЕЛЬНАЯ СИСТЕМА</p><h1>Бронхиолит</h1><p>Bronchiolitis</p><nav class="readable-outline" aria-label="Бронхиолит — оглавление"><a href="#/protocol/bronchiolitis?section=algorithm">Клинический алгоритм</a><a href="#/protocol/bronchiolitis?section=clinical">Клиническая картина</a><a href="#/protocol/bronchiolitis?section=severity">Оценка тяжести</a><a href="#/protocol/bronchiolitis?section=emergency">Неотложная помощь</a><a href="#/protocol/bronchiolitis?section=escalation">Эскалация помощи</a><a href="#/protocol/bronchiolitis?section=diagnostics">Экстренная диагностика</a><a href="#/protocol/bronchiolitis?section=routing">Маршрутизация</a><a href="#/protocol/bronchiolitis?section=case">Клинический случай</a><a href="#/protocol/bronchiolitis?section=references">Клинические рекомендации</a></nav><div class="readable-summary"><strong>Главное за минуту</strong><p>Основная помощь — поддержание дыхания и гидратации. При апноэ или истощении требуется немедленная эскалация.</p></div><p>Острый вирусный бронхиолит у детей младше 2 лет. Взрослые формы заболевания в эту карточку не входят.</p><section id="/protocol/bronchiolitis?section=algorithm" class="readable-section"><h2><span>01</span> Клинический алгоритм</h2><div class="readable-scroll"><svg viewBox="0 0 720 915" role="img" aria-label="Бронхиолит — алгоритм" style="width:100%;min-width:580px;max-width:800px"><defs><marker id="readable-arrow-bronchiolitis" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0 0L6 3L0 6" fill="none" stroke="#52748c"/></marker></defs><path d="M360 80V110H360V135" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-bronchiolitis)"/><path d="M360 200V242.5H170V280" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-bronchiolitis)"/><text x="265" y="232.5" text-anchor="middle" font-size="11">Да</text><path d="M360 200V242.5H550V280" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-bronchiolitis)"/><text x="455" y="232.5" text-anchor="middle" font-size="11">Нет</text><path d="M170 345V512.5H170V675" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-bronchiolitis)"/><path d="M550 345V380H550V410" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-bronchiolitis)"/><path d="M550 475V510H550V540" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-bronchiolitis)"/><path d="M550 605V642.5H550V675" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-bronchiolitis)"/><text x="585" y="632.5" text-anchor="middle" font-size="11">Да</text><path d="M550 605V642.5H170V675" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-bronchiolitis)"/><text x="360" y="632.5" text-anchor="middle" font-size="11">Нет / хуже</text><path d="M170 740V777.5H360V810" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-bronchiolitis)"/><path d="M550 740V777.5H360V810" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-bronchiolitis)"/><g><rect x="255" y="20" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="360" y="44" text-anchor="middle" font-size="12">Кашель / свист</text><text x="360" y="60" text-anchor="middle" font-size="12">у младенца</text></g><g><rect x="255" y="140" width="210" height="60" rx="17" fill="#edf5fb" stroke="#467495"/><text x="360" y="164" text-anchor="middle" font-size="12">Апноэ, цианоз,</text><text x="360" y="180" text-anchor="middle" font-size="12">истощение?</text></g><g><rect x="65" y="285" width="210" height="60" rx="7" fill="#fff0ed" stroke="#467495"/><text x="170" y="309" text-anchor="middle" font-size="12">Команда + поддержка</text><text x="170" y="325" text-anchor="middle" font-size="12">дыхания</text></g><g><rect x="445" y="285" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="550" y="309" text-anchor="middle" font-size="12">Дыхание, SpO₂,</text><text x="550" y="325" text-anchor="middle" font-size="12">кормление, гидратация</text></g><g><rect x="445" y="415" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="550" y="439" text-anchor="middle" font-size="12">Кислород / гидратация</text><text x="550" y="455" text-anchor="middle" font-size="12">по показаниям</text></g><g><rect x="445" y="545" width="210" height="60" rx="17" fill="#edf5fb" stroke="#467495"/><text x="550" y="569" text-anchor="middle" font-size="12">Состояние</text><text x="550" y="585" text-anchor="middle" font-size="12">улучшается?</text></g><g><rect x="65" y="680" width="210" height="60" rx="7" fill="#fff0ed" stroke="#467495"/><text x="170" y="712" text-anchor="middle" font-size="12">ОРИТ / ранний перевод</text></g><g><rect x="445" y="680" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="550" y="712" text-anchor="middle" font-size="12">Наблюдение / стационар</text></g><g><rect x="255" y="815" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="360" y="847" text-anchor="middle" font-size="12">Переоценка и маршрут</text></g></svg></div><h3>Действия и условия перехода</h3><ol class="readable-steps"><li><h3>Кашель / свист у младенца</h3><p>Уточнить продром, кормление, возраст, эпизоды апноэ и факторы риска.</p><p class="readable-transition">→ Апноэ, цианоз, истощение?</p></li><li><h3>Апноэ, цианоз, истощение?</h3><p>Оценивать ребёнка, а не только цифру сатурации.</p><p class="readable-transition">Да → Команда + поддержка дыхания<br>Нет → Дыхание, SpO₂, кормление, гидратация</p></li><li><h3>Команда + поддержка дыхания</h3><p>Реанимационная зона, эффективная вентиляция по состоянию, раннее привлечение ОРИТ.</p><p class="readable-transition">→ ОРИТ / ранний перевод</p></li><li><h3>Дыхание, SpO₂, кормление, гидратация</h3><p>Оценить стойкость десатурации и группу порога в таблице. Не назначать бронходилататор рутинно.</p><p class="readable-transition">→ Кислород / гидратация по показаниям</p></li><li><h3>Кислород / гидратация по показаниям</h3><p>При стабильной сатурации и достаточном питании может быть достаточно наблюдения.</p><p class="readable-transition">→ Состояние улучшается?</p></li><li><h3>Состояние улучшается?</h3><p>Повторно оценить дыхательное усилие, сознание, сатурацию и способность питаться.</p><p class="readable-transition">Да → Наблюдение / стационар<br>Нет / хуже → ОРИТ / ранний перевод</p></li><li><h3>ОРИТ / ранний перевод</h3><p>Нарастание поддержки, апноэ или утомление требуют профильной команды. Не ждать анализов при декомпенсации.</p><p class="readable-transition">→ Переоценка и маршрут</p></li><li><h3>Наблюдение / стационар</h3><p>Маршрут зависит от кислорода, кормления, факторов риска и безопасности наблюдения дома.</p><p class="readable-transition">→ Переоценка и маршрут</p></li><li><h3>Переоценка и маршрут</h3><p>Выписка только при клинической стабильности, безопасном кормлении и выполнении критериев сатурации.</p></li></ol></section><section id="/protocol/bronchiolitis?section=clinical" class="readable-section"><h2><span>02</span> Клиническая картина</h2><p>У младенца после насморка появляются кашель, тахипноэ, втяжения, двусторонние хрипы или свист, ухудшается кормление. У самых маленьких младенцев ведущим проявлением может быть апноэ.</p><div class="readable-block readable-danger"><h3>Немедленно вызвать реанимационную команду</h3><p>Апноэ, центральный цианоз, угнетение сознания, истощение или ослабление дыхательного усилия — признаки угрозы дыхательной недостаточности. Начать поддержку дыхательных путей и вентиляции по состоянию; обследования не задерживают помощь.</p></div><div class="readable-block "><h3>Кто требует особенно внимательного наблюдения</h3><p>Младенческий возраст, недоношенность, хроническое заболевание лёгких, значимый порок сердца, неврологическая патология или иммунодефицит повышают риск ухудшения. Оценивать динамику, кормление и гидратацию вместе с дыханием.</p></div><figure class="readable-image-slot"><strong>Место для изображения 1</strong><p>Признаки дыхательного усилия у младенца</p></figure></section><section id="/protocol/bronchiolitis?section=severity" class="readable-section"><h2><span>03</span> Оценка тяжести</h2><div class="readable-table"><h3>Клинические признаки тяжести</h3><div class="readable-scroll" tabindex="0"><table><thead><tr><th scope="col">Состояние</th><th scope="col">Ориентиры</th></tr></thead><tbody><tr><th scope="row">Стабильное течение</th><td>Небольшое усилие, достаточное кормление, апноэ нет.</td></tr><tr><th scope="row">Нужна стационарная оценка</th><td>Стойкая гипоксемия, выраженная работа дыхания, недостаточное питание или обезвоживание.</td></tr><tr><th scope="row">Угроза дыхательной недостаточности</th><td>Апноэ, истощение, цианоз, ослабление усилия или нарушение сознания.</td></tr></tbody></table></div></div></section><section id="/protocol/bronchiolitis?section=emergency" class="readable-section"><h2><span>04</span> Неотложная помощь</h2><div class="readable-block "><h3>PAT и ABCDE с акцентом на B и D</h3><p>Наблюдать за поведением, работой дыхания и цветом. Затем оценить проходимость дыхательных путей, эффективность вентиляции, сатурацию, перфузию и сознание. Апноэ у маленького младенца может быть ведущим проявлением. Минимизировать лишние манипуляции.</p></div><div class="readable-block "><h3>Гидратация и уход</h3><p>Небольшие кормления допустимы при безопасном глотании. При недостаточном приёме рассмотреть назогастральную/орогастральную гидратацию; при её непереносимости или угрозе дыхательной недостаточности — внутривенные изотонические жидкости. Поверхностная санация носа может помочь при секрете, мешающем кормлению; глубокую санацию рутинно не выполнять.</p></div><div class="readable-block "><h3>Чего не назначать рутинно</h3><p>При типичном бронхиолите не использовать сальбутамол, ипратропий/фенотерол, глюкокортикостероиды, небулизированный адреналин, гипертонический раствор, антибиотики или противовирусные средства как стандартное лечение. Другая подтверждённая патология требует собственного протокола.</p></div><div class="readable-block "><h3>Эскалация дыхательной поддержки</h3><p>Нарастающая потребность в кислороде, апноэ или истощение требуют старшего врача и ОРИТ. Высокопоточную поддержку рассматривать при неэффективности обычного кислорода; при угрозе дыхательной недостаточности — CPAP/другая вентиляционная поддержка профильной командой. Ухудшение не должно ждать планового интервала переоценки.</p></div><div class="readable-table"><h3>SpO₂: различать направление, кислород и выписку</h3><div class="readable-scroll" tabindex="0"><table><thead><tr><th scope="col">Ситуация</th><th scope="col">Критерий NICE NG9</th><th scope="col">Действие</th></tr></thead><tbody><tr><th scope="row">Направление на стационарную оценку</th><td>Стойкая SpO₂ &lt;92% на воздухе</td><td>Рассмотреть направление с учётом клиники и риска</td></tr><tr><th scope="row">Кислород: ≥6 недель, без фонового заболевания</th><td>Стойкая SpO₂ &lt;90%</td><td>Назначить дополнительный кислород</td></tr><tr><th scope="row">Кислород: &lt;6 недель ИЛИ фоновое заболевание</th><td>Стойкая SpO₂ &lt;92%</td><td>Назначить дополнительный кислород</td></tr><tr><th scope="row">Выписка: ≥6 недель, без фонового заболевания</th><td>SpO₂ &gt;90% на воздухе ≥4 ч, включая сон</td><td>Дополнительно оценить стабильность и кормление</td></tr><tr><th scope="row">Выписка: &lt;6 недель ИЛИ фоновое заболевание</th><td>SpO₂ &gt;92% на воздухе ≥4 ч, включая сон</td><td>Дополнительно оценить стабильность и кормление</td></tr></tbody></table></div><p>Пороги относятся к стойким значениям и указанной группе. Учитывать качество сигнала и индивидуальные цели.</p></div><h3>Повторная оценка</h3><p>После поддержки повторно оценить дыхательное усилие, стойкость гипоксемии, переносимость кормления и диурез. Интерпретировать сатурацию вместе с клиникой и качеством сигнала.</p></section><section id="/protocol/bronchiolitis?section=escalation" class="readable-section"><h2><span>05</span> Эскалация помощи</h2><p>Апноэ, истощение и неэффективность начальной поддержки требуют раннего участия ОРИТ. При неэффективности обычного кислорода профильная команда оценивает необходимость высокопоточной или иной вентиляционной поддержки.</p></section><section id="/protocol/bronchiolitis?section=diagnostics" class="readable-section"><h2><span>06</span> Экстренная диагностика</h2><div class="readable-block "><h3>Клиническое распознавание</h3><p>Обычно после насморка возникают кашель, учащённое дыхание, втяжения, двусторонние мелкие хрипы и/или свистящее дыхание, ухудшение кормления. У старшего ребёнка с повторными эпизодами свиста оценить альтернативу — вирус-индуцированное свистящее дыхание или астму.</p></div><div class="readable-block "><h3>Исследования по ситуации</h3><p>При типичном течении рентгенография, анализы и вирусологические тесты для выбора индивидуального лечения обычно не нужны. При ухудшении или неясном диагнозе искать пневмонию, сепсис, сердечную патологию, инородное тело; газы крови — при подозрении на дыхательную недостаточность.</p></div><div class="readable-table"><h3>Механизмы и дифференциальная диагностика</h3><div class="readable-scroll" tabindex="0"><table><thead><tr><th scope="col">Состояние</th><th scope="col">Ориентиры</th></tr></thead><tbody><tr><th scope="row">Пневмония</th><td>Выраженная лихорадка, токсический вид или фокальные признаки.</td></tr><tr><th scope="row">Астма / вирусный свист</th><td>Повторные эпизоды у ребёнка старшего возраста, атопия.</td></tr><tr><th scope="row">Инородное тело</th><td>Внезапное начало и односторонние изменения.</td></tr></tbody></table></div></div><figure class="readable-image-slot"><strong>Место для изображения 2</strong><p>Схема оценки кормления и гидратации</p></figure></section><section id="/protocol/bronchiolitis?section=routing" class="readable-section"><h2><span>07</span> Маршрутизация</h2><div class="readable-block "><h3>Госпитализация и ОРИТ</h3><p>Апноэ, стойкая гипоксемия, тяжёлое усилие дыхания, недостаточное кормление/обезвоживание либо значимые факторы риска — основания для стационарной оценки. Повторные апноэ, истощение, неэффективная вентиляция и нарастающая поддержка — раннее привлечение ОРИТ.</p></div><div class="readable-block "><h3>Перед выпиской</h3><p>Нужны клиническая стабильность, достаточное питание, соблюдение критериев сатурации в таблице, понятные семье признаки ухудшения и доступ к помощи. Апноэ, посинение, вялость или невозможность кормления — повод немедленно обратиться за помощью.</p></div></section><section id="/protocol/bronchiolitis?section=case" class="readable-section"><h2><span>08</span> Клинический случай</h2><h3>Учебный сценарий</h3><p>Младенец 4 месяцев после насморка чаще дышит и хуже ест. Есть двусторонние хрипы и втяжения. SpO₂ устойчиво 88% на воздухе.</p><h3>Какая помощь нужна в первую очередь?</h3><h3>Разбор и тактика</h3><p>Кислород, оценка работы дыхания и гидратации, стационарная оценка. При типичном бронхиолите стандартная помощь поддерживающая. Сальбутамол рутинно не назначают. При апноэ или истощении нужна немедленная эскалация.</p></section><section id="/protocol/bronchiolitis?section=references" class="readable-section"><h2><span>09</span> Клинические рекомендации</h2><ol><li><strong>Bronchiolitis in children: diagnosis and management — NG9</strong><p>NICE · Обновление 09.08.2021</p><a href="https://www.nice.org.uk/guidance/ng9/chapter/Recommendations" target="_blank" rel="noreferrer">Открыть рекомендацию</a></li><li><strong>Bronchiolitis</strong><p>Royal Children’s Hospital Melbourne · Ноябрь 2023</p><a href="https://www.rch.org.au/clinicalguide/guideline_index/Bronchiolitis_Guideline/" target="_blank" rel="noreferrer">Открыть рекомендацию</a></li></ol></section></article><article id="/protocol/epiglottitis" class="readable-article"><a href="#/system/respiratory?age=pediatric">← Все дыхательные темы</a><p class="readable-kicker">ПЕДИАТРИЯ · ДЫХАТЕЛЬНАЯ СИСТЕМА</p><h1>Эпиглоттит</h1><p>Epiglottitis</p><nav class="readable-outline" aria-label="Эпиглоттит — оглавление"><a href="#/protocol/epiglottitis?section=algorithm">Клинический алгоритм</a><a href="#/protocol/epiglottitis?section=clinical">Клиническая картина</a><a href="#/protocol/epiglottitis?section=severity">Оценка тяжести</a><a href="#/protocol/epiglottitis?section=emergency">Неотложная помощь</a><a href="#/protocol/epiglottitis?section=escalation">Эскалация помощи</a><a href="#/protocol/epiglottitis?section=diagnostics">Экстренная диагностика</a><a href="#/protocol/epiglottitis?section=routing">Маршрутизация</a><a href="#/protocol/epiglottitis?section=case">Клинический случай</a><a href="#/protocol/epiglottitis?section=references">Клинические рекомендации</a></nav><div class="readable-summary"><strong>Главное за минуту</strong><p>Не осматривать глотку шпателем и не укладывать насильно. Рано вызвать анестезиолога, ЛОР и реанимационную команду.</p></div><p>Подозрение на эпиглоттит у ребёнка — потенциально нестабильные дыхательные пути, даже если пока нет выраженного стридора.</p><section id="/protocol/epiglottitis?section=algorithm" class="readable-section"><h2><span>01</span> Клинический алгоритм</h2><div class="readable-scroll"><svg viewBox="0 0 720 915" role="img" aria-label="Эпиглоттит — алгоритм" style="width:100%;min-width:580px;max-width:800px"><defs><marker id="readable-arrow-epiglottitis" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0 0L6 3L0 6" fill="none" stroke="#52748c"/></marker></defs><path d="M360 80V112.5H360V140" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-epiglottitis)"/><path d="M360 205V237.5H360V265" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-epiglottitis)"/><path d="M360 330V375H170V415" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-epiglottitis)"/><text x="265" y="365" text-anchor="middle" font-size="11">Да</text><path d="M360 330V375H550V415" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-epiglottitis)"/><text x="455" y="365" text-anchor="middle" font-size="11">Пока нет</text><path d="M170 480V522.5H360V560" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-epiglottitis)"/><path d="M550 480V522.5H360V560" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-epiglottitis)"/><path d="M360 625V657.5H360V685" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-epiglottitis)"/><path d="M360 750V782.5H360V810" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-epiglottitis)"/><g><rect x="255" y="20" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="360" y="44" text-anchor="middle" font-size="12">Дисфагия + слюнотечение</text><text x="360" y="60" text-anchor="middle" font-size="12">± приглушённый голос</text></g><g><rect x="255" y="145" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="360" y="169" text-anchor="middle" font-size="12">Вызов анестезиолога / ЛОР</text><text x="360" y="185" text-anchor="middle" font-size="12">Минимум манипуляций</text></g><g><rect x="255" y="270" width="210" height="60" rx="17" fill="#edf5fb" stroke="#467495"/><text x="360" y="294" text-anchor="middle" font-size="12">Есть признаки</text><text x="360" y="310" text-anchor="middle" font-size="12">декомпенсации?</text></g><g><rect x="65" y="420" width="210" height="60" rx="7" fill="#fff0ed" stroke="#467495"/><text x="170" y="444" text-anchor="middle" font-size="12">Немедленная поддержка</text><text x="170" y="460" text-anchor="middle" font-size="12">дыхательных путей</text></g><g><rect x="445" y="420" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="550" y="444" text-anchor="middle" font-size="12">Экспертная оценка</text><text x="550" y="460" text-anchor="middle" font-size="12">в зоне готовности</text></g><g><rect x="255" y="565" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="360" y="589" text-anchor="middle" font-size="12">Безопасность дыхательных</text><text x="360" y="605" text-anchor="middle" font-size="12">путей обеспечена</text></g><g><rect x="255" y="690" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="360" y="714" text-anchor="middle" font-size="12">Парентеральный антибиотик</text><text x="360" y="730" text-anchor="middle" font-size="12">Исследования по показаниям</text></g><g><rect x="255" y="815" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="360" y="839" text-anchor="middle" font-size="12">Стационар / ОРИТ</text><text x="360" y="855" text-anchor="middle" font-size="12">Непрерывная переоценка</text></g></svg></div><h3>Действия и условия перехода</h3><ol class="readable-steps"><li><h3>Дисфагия + слюнотечение ± приглушённый голос</h3><p>Подозревать эпиглоттит при остром начале и токсическом виде. Стридор может появляться поздно.</p><p class="readable-transition">→ Вызов анестезиолога / ЛОР Минимум манипуляций</p></li><li><h3>Вызов анестезиолога / ЛОР Минимум манипуляций</h3><p>Положение комфорта; не осматривать глотку шпателем, не брать мазок, не укладывать насильно.</p><p class="readable-transition">→ Есть признаки декомпенсации?</p></li><li><h3>Есть признаки декомпенсации?</h3><p>Цианоз, апноэ, плохой воздушный поток, истощение, нарушение сознания.</p><p class="readable-transition">Да → Немедленная поддержка дыхательных путей<br>Пока нет → Экспертная оценка в зоне готовности</p></li><li><h3>Немедленная поддержка дыхательных путей</h3><p>Опытная команда, вентиляция по состоянию и резервный план; при остановке — возрастная реанимация.</p><p class="readable-transition">→ Безопасность дыхательных путей обеспечена</p></li><li><h3>Экспертная оценка в зоне готовности</h3><p>Отсутствие декомпенсации не означает безопасную выписку. Наблюдать непрерывно.</p><p class="readable-transition">→ Безопасность дыхательных путей обеспечена</p></li><li><h3>Безопасность дыхательных путей обеспечена</h3><p>Способ и момент вмешательства определяет команда по динамике состояния.</p><p class="readable-transition">→ Парентеральный антибиотик Исследования по показаниям</p></li><li><h3>Парентеральный антибиотик Исследования по показаниям</h3><p>Не задерживать обеспечение дыхания ради доступа, анализов или антибиотика.</p><p class="readable-transition">→ Стационар / ОРИТ Непрерывная переоценка</p></li><li><h3>Стационар / ОРИТ Непрерывная переоценка</h3><p>При ухудшении — немедленная повторная активация команды. Выписка только после стационарного лечения.</p></li></ol></section><section id="/protocol/epiglottitis?section=clinical" class="readable-section"><h2><span>02</span> Клиническая картина</h2><p>Острое воспаление надгортанника и прилегающих структур может быстро привести к обструкции. Характерны высокая лихорадка, боль при глотании, слюнотечение, приглушённый голос и поза сидя с наклоном вперёд. Стридор может быть поздним проявлением.</p><div class="readable-block readable-danger"><h3>Минимум манипуляций до готовности команды</h3><p>Слюнотечение, дисфагия, приглушённый голос, высокая лихорадка/токсический вид и удобная только сидячая поза требуют срочного экспертного осмотра. Не провоцировать плач, не брать мазок и не пытаться увидеть надгортанник шпателем.</p></div><div class="readable-block readable-danger"><h3>Декомпенсация</h3><p>Цианоз, апноэ, ослабление дыхания, истощение или изменение сознания требуют немедленного плана вентиляции и обеспечения дыхательных путей. Нормальная сатурация и отсутствие громкого стридора не гарантируют безопасности.</p></div><figure class="readable-image-slot"><strong>Место для изображения 1</strong><p>Анатомия надгортанника и признаки супраглоттического отёка</p></figure></section><section id="/protocol/epiglottitis?section=severity" class="readable-section"><h2><span>03</span> Оценка тяжести</h2><div class="readable-table"><h3>Клинические признаки тяжести</h3><div class="readable-scroll" tabindex="0"><table><thead><tr><th scope="col">Состояние</th><th scope="col">Ориентиры</th></tr></thead><tbody><tr><th scope="row">Подозрение</th><td>Дисфагия, слюнотечение и вынужденная поза даже при внешне сохранном дыхании.</td></tr><tr><th scope="row">Тяжёлая обструкция</th><td>Стридор, выраженные втяжения и плохое поступление воздуха.</td></tr><tr><th scope="row">Декомпенсация</th><td>Истощение, цианоз, апноэ или угнетение сознания.</td></tr></tbody></table></div></div></section><section id="/protocol/epiglottitis?section=emergency" class="readable-section"><h2><span>04</span> Неотложная помощь</h2><div class="readable-block "><h3>Наблюдать, не тревожа</h3><p>A/B: положение, голос, глотание слюны, воздушный поток и работа дыхания. D: поведение и контакт. Оставить с родителем в выбранном положении; кислород и мониторинг — если переносятся без усиления дистресса.</p></div><div class="readable-block "><h3>Дыхательные пути — приоритет</h3><p>Немедленно привлечь детского анестезиолога/реаниматолога и ЛОР. Не заставлять ложиться, пить или принимать пероральные препараты. Команда определяет раннюю контролируемую интубацию и резервный план. Многократные неподготовленные попытки и седация вне плана дыхательных путей опасны.</p></div><div class="readable-block "><h3>Антибиотик и поддерживающее лечение</h3><p>Парентеральную антибактериальную терапию начинать без задержки жизнеспасающего обеспечения дыхания; выбранная исходная схема указана в таблице. Корректировать по возрасту, аллергии, микробиологии и локальной резистентности. При потребности в жидкости — индивидуальная оценка после приоритета дыхательных путей.</p></div><div class="readable-block "><h3>ГКС и адреналин не заменяют контроль дыхательных путей</h3><p>Глюкокортикостероиды могут рассматриваться профильной командой; доказательства пользы ограничены. Адреналин не является окончательным лечением эпиглоттита. При тяжёлой обструкции некоторые руководства допускают его как временную меру, не задерживающую экспертное обеспечение дыхательных путей.</p></div><div class="readable-table"><h3>Выбранная схема антибиотика — RCH</h3><div class="readable-scroll" tabindex="0"><table><thead><tr><th scope="col">Препарат</th><th scope="col">Доза / путь / частота</th><th scope="col">Продолжительность и ограничения</th></tr></thead><tbody><tr><th scope="row">Цефтриаксон</th><td>50 мг/кг на дозу, максимум 2 г; IV каждые 24 часа</td><td>В RCH — 5 дней. Срок и препарат уточнить по клинике и локальному формуляру</td></tr></tbody></table></div><p>Таблица не заменяет выбор команды. При новорождённом возрасте, аллергии или противопоказаниях к цефтриаксону нужен отдельный выбор антибиотика. IM в RCH допускается, но болезненная манипуляция не должна ухудшать обструкцию.</p></div><h3>Повторная оценка</h3><p>Наблюдать за голосом, глотанием слюны, воздушным потоком, втяжениями и сознанием. Пульсоксиметрию и другие измерения проводить по переносимости без усиления дистресса.</p></section><section id="/protocol/epiglottitis?section=escalation" class="readable-section"><h2><span>05</span> Эскалация помощи</h2><p>При обоснованном подозрении сразу привлечь анестезиолога, ЛОР и реанимационную команду. При нарастании обструкции нужна готовность к немедленной вентиляции и контролируемому обеспечению дыхательных путей.</p></section><section id="/protocol/epiglottitis?section=diagnostics" class="readable-section"><h2><span>06</span> Экстренная диагностика</h2><div class="readable-block "><h3>Сначала безопасность дыхательных путей</h3><p>Диагноз в первые минуты клинический. Ненужные исследования, венозный доступ и транспортировку на снимок отложить до готовности обеспечить дыхательные пути. Ларингоскопия — специалистом в контролируемых условиях. Лабораторные исследования и посевы после стабилизации не должны задерживать антибиотик.</p></div><div class="readable-block "><h3>Дифференциальная диагностика</h3><p>Круп, бактериальный трахеит, заглоточный/паратонзиллярный абсцесс, анафилаксия, инородное тело, травма/ожог дыхательных путей. Сохранная вакцинация против Hib не исключает эпиглоттит другой этиологии.</p></div><div class="readable-table"><h3>Механизмы и дифференциальная диагностика</h3><div class="readable-scroll" tabindex="0"><table><thead><tr><th scope="col">Состояние</th><th scope="col">Ориентиры</th></tr></thead><tbody><tr><th scope="row">Круп</th><td>Лающий кашель и осиплость, обычно без выраженного слюнотечения.</td></tr><tr><th scope="row">Бактериальный трахеит</th><td>Токсический вид, густые секреты, нарастание обструкции.</td></tr><tr><th scope="row">Глубокая инфекция шеи</th><td>Дисфагия с асимметрией или ограничением подвижности шеи.</td></tr></tbody></table></div></div><figure class="readable-image-slot"><strong>Место для изображения 2</strong><p>Схема безопасной организации помощи при подозрении на эпиглоттит</p></figure></section><section id="/protocol/epiglottitis?section=routing" class="readable-section"><h2><span>07</span> Маршрутизация</h2><div class="readable-block "><h3>Стационар и непрерывное наблюдение</h3><p>При подозрении на эпиглоттит требуется экстренная госпитализация с возможностью детского обеспечения дыхательных путей. ОРИТ особенно необходима при дыхательной поддержке, изменении сознания, гипоксемии или нестабильной гемодинамике. Перевод согласовать заранее с принимающей командой и возможностью поддерживать дыхание в пути.</p></div><div class="readable-block "><h3>Выписка не является решением первичного этапа</h3><p>Решение принимает профильная команда после стационарного лечения, устойчивого восстановления дыхания и глотания, оценки осложнений и плана завершения терапии. «Временно стало легче» не является достаточным критерием.</p></div></section><section id="/protocol/epiglottitis?section=case" class="readable-section"><h2><span>08</span> Клинический случай</h2><h3>Учебный сценарий</h3><p>Ребёнок 4 лет. Температура 39,4 °C, сильная боль при глотании, слюнотечение и приглушённый голос. Сидит, наклонившись вперёд. Появился стридор.</p><h3>Что сделать до попытки осмотра глотки?</h3><h3>Разбор и тактика</h3><p>Подозревать эпиглоттит. Оставить ребёнка в удобной позе, вызвать анестезиолога и ЛОР. Избегать шпателя, мазка и принудительного укладывания. Контроль дыхательных путей определяет порядок исследований и терапии.</p></section><section id="/protocol/epiglottitis?section=references" class="readable-section"><h2><span>09</span> Клинические рекомендации</h2><ol><li><strong>Sore throat — Epiglottitis/Bacterial tracheitis</strong><p>Royal Children’s Hospital Melbourne · Октябрь 2024</p><a href="https://www.rch.org.au/clinicalguide/guideline_index/sore_throat/" target="_blank" rel="noreferrer">Открыть рекомендацию</a></li><li><strong>Acute upper airway obstruction</strong><p>Royal Children’s Hospital Melbourne · Онлайн-редакция; год публикации не указан</p><a href="https://www.rch.org.au/clinicalguide/guideline_index/Acute_upper_airway_obstruction/" target="_blank" rel="noreferrer">Открыть рекомендацию</a></li></ol></section></article><article id="/protocol/acute-asthma" class="readable-article"><a href="#/system/respiratory?age=pediatric">← Все дыхательные темы</a><p class="readable-kicker">ПЕДИАТРИЯ · ДЫХАТЕЛЬНАЯ СИСТЕМА</p><h1>Острый приступ бронхиальной астмы</h1><p>Acute asthma</p><nav class="readable-outline" aria-label="Острый приступ бронхиальной астмы — оглавление"><a href="#/protocol/acute-asthma?section=algorithm">Клинический алгоритм</a><a href="#/protocol/acute-asthma?section=clinical">Клиническая картина</a><a href="#/protocol/acute-asthma?section=severity">Оценка тяжести</a><a href="#/protocol/acute-asthma?section=emergency">Неотложная помощь</a><a href="#/protocol/acute-asthma?section=escalation">Эскалация помощи</a><a href="#/protocol/acute-asthma?section=diagnostics">Экстренная диагностика</a><a href="#/protocol/acute-asthma?section=routing">Маршрутизация</a><a href="#/protocol/acute-asthma?section=case">Клинический случай</a><a href="#/protocol/acute-asthma?section=references">Клинические рекомендации</a></nav><div class="readable-summary"><strong>Главное за минуту</strong><p>При «немом лёгком», истощении или нарушении сознания не ждать первого часа лечения: немедленно вызвать ОРИТ/анестезиолога.</p></div><p>Острое обострение астмы, включая астматический статус. Быстрая лекарственная таблица и схема ниже адаптированы для детей 6–11 лет; для младших детей и подростков нужны возрастные схемы.</p><section id="/protocol/acute-asthma?section=algorithm" class="readable-section"><h2><span>01</span> Клинический алгоритм</h2><div class="readable-scroll"><svg viewBox="0 0 720 990" role="img" aria-label="Острый приступ бронхиальной астмы — алгоритм" style="width:100%;min-width:580px;max-width:800px"><defs><marker id="readable-arrow-acute-asthma" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0 0L6 3L0 6" fill="none" stroke="#52748c"/></marker></defs><path d="M360 80V112.5H360V140" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-acute-asthma)"/><path d="M360 205V250H170V290" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-acute-asthma)"/><text x="265" y="240" text-anchor="middle" font-size="11">Да</text><path d="M360 205V250H550V290" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-acute-asthma)"/><text x="455" y="240" text-anchor="middle" font-size="11">Нет</text><path d="M170 355V550H170V740" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-acute-asthma)"/><path d="M550 355V400H550V440" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-acute-asthma)"/><path d="M550 505V550H550V590" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-acute-asthma)"/><path d="M550 655V700H550V740" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-acute-asthma)"/><text x="585" y="690" text-anchor="middle" font-size="11">Да</text><path d="M550 655V700H170V740" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-acute-asthma)"/><text x="360" y="690" text-anchor="middle" font-size="11">Нет / хуже</text><path d="M170 805V847.5H360V885" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-acute-asthma)"/><path d="M550 805V847.5H360V885" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-acute-asthma)"/><g><rect x="255" y="20" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="360" y="44" text-anchor="middle" font-size="12">Приступ астмы</text><text x="360" y="60" text-anchor="middle" font-size="12">Дозовая схема: 6–11 лет</text></g><g><rect x="255" y="145" width="210" height="60" rx="17" fill="#edf5fb" stroke="#467495"/><text x="360" y="169" text-anchor="middle" font-size="12">Истощение / сознание /</text><text x="360" y="185" text-anchor="middle" font-size="12">«немое лёгкое»?</text></g><g><rect x="65" y="295" width="210" height="60" rx="7" fill="#fff0ed" stroke="#467495"/><text x="170" y="319" text-anchor="middle" font-size="12">Немедленно ОРИТ /</text><text x="170" y="335" text-anchor="middle" font-size="12">анестезиолог + лечение</text></g><g><rect x="445" y="295" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="550" y="319" text-anchor="middle" font-size="12">Оценить тяжесть</text><text x="550" y="335" text-anchor="middle" font-size="12">и уже полученное лечение</text></g><g><rect x="445" y="445" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="550" y="469" text-anchor="middle" font-size="12">SABA ± ипратропий</text><text x="550" y="485" text-anchor="middle" font-size="12">Ранний ГКС; O₂ по цели</text></g><g><rect x="445" y="595" width="210" height="60" rx="17" fill="#edf5fb" stroke="#467495"/><text x="550" y="619" text-anchor="middle" font-size="12">Клинический</text><text x="550" y="635" text-anchor="middle" font-size="12">ответ достаточен?</text></g><g><rect x="65" y="745" width="210" height="60" rx="7" fill="#fff0ed" stroke="#467495"/><text x="170" y="769" text-anchor="middle" font-size="12">Старший врач / ОРИТ</text><text x="170" y="785" text-anchor="middle" font-size="12">Рассмотреть MgSO₄</text></g><g><rect x="445" y="745" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="550" y="769" text-anchor="middle" font-size="12">Снижать интенсивность</text><text x="550" y="785" text-anchor="middle" font-size="12">по устойчивому ответу</text></g><g><rect x="255" y="890" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="360" y="914" text-anchor="middle" font-size="12">Определить маршрут</text><text x="360" y="930" text-anchor="middle" font-size="12">и план дальнейшего лечения</text></g></svg></div><h3>Действия и условия перехода</h3><ol class="readable-steps"><li><h3>Приступ астмы Дозовая схема: 6–11 лет</h3><p>Начать оценку и помощь параллельно. Для иных возрастов использовать отдельную возрастную схему.</p><p class="readable-transition">→ Истощение / сознание / «немое лёгкое»?</p></li><li><h3>Истощение / сознание / «немое лёгкое»?</h3><p>Не ждать результата анализов и плановой переоценки через час.</p><p class="readable-transition">Да → Немедленно ОРИТ / анестезиолог + лечение<br>Нет → Оценить тяжесть и уже полученное лечение</p></li><li><h3>Немедленно ОРИТ / анестезиолог + лечение</h3><p>Кислород, ингаляционные бронходилататоры, системный ГКС и поддержка дыхания по состоянию.</p><p class="readable-transition">→ Старший врач / ОРИТ Рассмотреть MgSO₄</p></li><li><h3>Оценить тяжесть и уже полученное лечение</h3><p>Подтвердить вероятную астму; проверить анафилаксию и альтернативные причины.</p><p class="readable-transition">→ SABA ± ипратропий Ранний ГКС; O₂ по цели</p></li><li><h3>SABA ± ипратропий Ранний ГКС; O₂ по цели</h3><p>Дозы, кратность, возраст и выбранный источник — в лекарственной таблице.</p><p class="readable-transition">→ Клинический ответ достаточен?</p></li><li><h3>Клинический ответ достаточен?</h3><p>Контроль после вмешательств; переоценить ранее часа при ухудшении.</p><p class="readable-transition">Да → Снижать интенсивность по устойчивому ответу<br>Нет / хуже → Старший врач / ОРИТ Рассмотреть MgSO₄</p></li><li><h3>Старший врач / ОРИТ Рассмотреть MgSO₄</h3><p>Проверить доставку препарата, альтернативный диагноз и токсичность SABA. Респираторная поддержка при неэффективном дыхании.</p><p class="readable-transition">→ Определить маршрут и план дальнейшего лечения</p></li><li><h3>Снижать интенсивность по устойчивому ответу</h3><p>Продолжить наблюдение, оценить кислород, питание, интервал между ингаляциями и план базисной терапии.</p><p class="readable-transition">→ Определить маршрут и план дальнейшего лечения</p></li><li><h3>Определить маршрут и план дальнейшего лечения</h3><p>Сохраняющаяся тяжесть — стационар/ОРИТ. Выписка — только при выполнении клинических критериев и безопасном плане.</p></li></ol></section><section id="/protocol/acute-asthma?section=clinical" class="readable-section"><h2><span>02</span> Клиническая картина</h2><p>Кашель, свист и затруднённый выдох часто сопровождаются нарастающей потребностью в бронходилататоре. При тяжёлом приступе ребёнок говорит отдельными словами, сидит вынужденно и активно использует вспомогательные мышцы.</p><div class="readable-block readable-danger"><h3>Признаки жизнеугрожающего обострения</h3><p>Истощение, сонливость/спутанность, цианоз, резко ослабленный воздушный поток, уменьшающееся дыхательное усилие или «немое лёгкое» требуют немедленной помощи команды ОРИТ/анестезиолога. Громкость свиста не отражает степень обструкции.</p></div><div class="readable-block "><h3>Не пропустить анафилаксию</h3><p>Быстрое начало после аллергена, кожные/слизистые проявления или гемодинамические нарушения требуют оценки анафилаксии. При сочетании с астмой приоритет — лечение анафилаксии по соответствующему алгоритму.</p></div><figure class="readable-image-slot"><strong>Место для изображения 1</strong><p>Техника дозированного ингалятора со спейсером</p></figure></section><section id="/protocol/acute-asthma?section=severity" class="readable-section"><h2><span>03</span> Оценка тяжести</h2><div class="readable-table"><h3>Клинические признаки тяжести</h3><div class="readable-scroll" tabindex="0"><table><thead><tr><th scope="col">Состояние</th><th scope="col">Ориентиры</th></tr></thead><tbody><tr><th scope="row">Лёгкое течение</th><td>Речь и активность сохранены, дыхательное усилие небольшое.</td></tr><tr><th scope="row">Среднетяжёлое</th><td>Ограничение речи и активности, заметные втяжения.</td></tr><tr><th scope="row">Тяжёлое</th><td>Выраженное усилие, плохой воздушный поток, гипоксемия.</td></tr><tr><th scope="row">Жизнеугрожающее</th><td>Истощение, изменённое сознание, «немое лёгкое» или ослабление усилия.</td></tr></tbody></table></div></div></section><section id="/protocol/acute-asthma?section=emergency" class="readable-section"><h2><span>04</span> Неотложная помощь</h2><div class="readable-block "><h3>B/D: воздушный поток, усилие и сознание</h3><p>Оценить состояние, активность, втяжения, вход воздуха и симметрию. Параллельно контролировать SpO₂ и гемодинамику; уточнить уже полученные дозы, прежнюю ОРИТ/интубацию и ответ на ингалятор. При малом возрасте и первом свистящем дыхании пересмотреть диагноз.</p></div><div class="readable-block "><h3>Начальная помощь</h3><p>Положение комфорта, ингаляционная бронходилатация, ранний системный ГКС при среднетяжёлом/тяжёлом приступе. MDI со спейсером эффективен при возможности доставки; при жизнеугрожающем состоянии способ доставки и поддержка определяются командой.</p></div><div class="readable-block "><h3>Переоценка и эскалация</h3><p>Контроль после каждой терапии; формальная оценка к концу первого часа или раньше. Нет ответа, нарастает кислородная потребность/утомление, ухудшается сознание — немедленно старший врач и ОРИТ. Непрерывный ингаляционный сальбутамол и IV-препараты — в условиях соответствующего мониторинга и компетенции.</p></div><div class="readable-block "><h3>Рефрактерное течение</h3><p>Магния сульфат — вариант второй линии после недостаточного ответа на исходную терапию; выбранная схема MSF приведена в таблице. Интубация и ИВЛ требуют опытной команды из-за риска динамической гиперинфляции. Рутинно седативные, антибиотики и IV-β₂-агонисты не назначать.</p></div><div class="readable-table"><h3>Начальная схема для детей 6–11 лет</h3><div class="readable-scroll" tabindex="0"><table><thead><tr><th scope="col">Средство / тяжесть</th><th scope="col">Доза и путь</th><th scope="col">Кратность / предел</th></tr></thead><tbody><tr><th scope="row">Сальбутамол: среднетяжёлый приступ</th><td>MDI 100 мкг/доза: 4–6 доз через спейсер ИЛИ NEB 2,5 мг</td><td>При необходимости до 3 введений с интервалом 20–30 мин</td></tr><tr><th scope="row">Сальбутамол: тяжёлый приступ</th><td>MDI 100 мкг/доза: 6–10 доз ИЛИ NEB 5 мг</td><td>При необходимости до 3 введений с интервалом 20–30 мин; непрерывный мониторинг</td></tr><tr><th scope="row">Ипратропий с SABA: среднетяжёлый/тяжёлый</th><td>MDI 20 мкг/доза: 4 дозы ИЛИ NEB 250 мкг</td><td>До 3 введений в начальном цикле</td></tr><tr><th scope="row">Преднизолон</th><td>Внутрь 1–2 мг/кг/сут; максимум 40 мг/сут</td><td>Обычно 3–5 дней; при невозможности PO — парентеральная схема специалиста</td></tr><tr><th scope="row">Кислород при гипоксемии</th><td>Контролируемая подача, цель SpO₂ 92–95%</td><td>GINA 2026; при жизнеугрожающем состоянии первоначально высокая концентрация с дальнейшей титрацией</td></tr></tbody></table></div><p>Выбрана тяжесть-зависимая схема GINA 2026 для указанного возраста. MDI и NEB — альтернативы доставки, а не одновременное суммирование доз.</p></div><div class="readable-table"><h3>Вторая линия при недостаточном ответе</h3><div class="readable-scroll" tabindex="0"><table><thead><tr><th scope="col">Средство</th><th scope="col">Выбранная схема</th><th scope="col">Контроль</th></tr></thead><tbody><tr><th scope="row">Магния сульфат IV</th><td>40 мг/кг, максимум 2 г, инфузия за 20 минут — MSF</td><td>Назначение старшим врачом, контроль АД; разведение и концентрация по формуляру</td></tr></tbody></table></div><p>В RCH используется 50 мг/кг, максимум 2 г. Не складывать и не чередовать эти схемы; вариант учреждения согласовать до применения.</p></div><h3>Повторная оценка</h3><p>После ингаляций проверить воздушный поток, работу дыхания, речь, сознание и SpO₂. Полная оценка ответа в течение первого часа, при ухудшении раньше.</p></section><section id="/protocol/acute-asthma?section=escalation" class="readable-section"><h2><span>05</span> Эскалация помощи</h2><p>При истощении или нарушении сознания сразу вызвать ОРИТ. При недостаточном ответе проверить доставку препаратов, ранее полученные дозы, токсичность SABA и альтернативный диагноз. Дополнительная терапия требует соответствующего мониторинга.</p></section><section id="/protocol/acute-asthma?section=diagnostics" class="readable-section"><h2><span>06</span> Экстренная диагностика</h2><div class="readable-block "><h3>Лечение не задерживать ради исследований</h3><p>При типичном приступе рентгенография и анализы обычно не нужны. При тяжёлом/рефрактерном течении газы крови и калий/лактат помогают оценить вентиляцию и токсичность β₂-агонистов; снимок — при подозрении на пневмоторакс, пневмонию или другую причину.</p></div><div class="readable-block "><h3>Тахипноэ может иметь другую причину</h3><p>После частого сальбутамола тахикардия, тремор, гипокалиемия и лактатацидоз могут имитировать ухудшение астмы. Оценить воздушный поток, работу дыхания и доступные анализы до бесконтрольного наращивания препарата.</p></div><div class="readable-table"><h3>Механизмы и дифференциальная диагностика</h3><div class="readable-scroll" tabindex="0"><table><thead><tr><th scope="col">Состояние</th><th scope="col">Ориентиры</th></tr></thead><tbody><tr><th scope="row">Анафилаксия</th><td>Аллерген, отёк, кожные проявления или гемодинамическое нарушение.</td></tr><tr><th scope="row">Инородное тело</th><td>Внезапное поперхивание, односторонний свист.</td></tr><tr><th scope="row">Пневмоторакс / пневмония</th><td>Боль, асимметрия, фокальные или инфекционные признаки.</td></tr></tbody></table></div></div><figure class="readable-image-slot"><strong>Место для изображения 2</strong><p>Признаки тяжёлого приступа у ребёнка</p></figure></section><section id="/protocol/acute-asthma?section=routing" class="readable-section"><h2><span>07</span> Маршрутизация</h2><div class="readable-block "><h3>Госпитализация / ОРИТ</h3><p>Сохраняющаяся тяжесть, потребность в кислороде, плохой ответ на ингаляционную терапию или нарастание поддержки требуют стационарного лечения. Угнетение сознания, истощение, неэффективная вентиляция или необходимость респираторной поддержки — срочная ОРИТ.</p></div><div class="readable-block "><h3>После устойчивого улучшения</h3><p>Оценить клиническую стабильность, сатурацию без кислорода, возможность пить и достаточный интервал без повторной потребности в сальбутамоле. Проверить технику ингаляции, базисную ICS-содержащую терапию и письменный план действий; организовать ранний контроль. Решение о выписке после тяжёлого приступа — старшим врачом.</p></div></section><section id="/protocol/acute-asthma?section=case" class="readable-section"><h2><span>08</span> Клинический случай</h2><h3>Учебный сценарий</h3><p>Ребёнок 8 лет с известной астмой. Домашний сальбутамол не помог. Говорит короткими фразами, выраженные втяжения и удлинённый выдох, SpO₂ 89%.</p><h3>Когда менять тактику и вызывать ОРИТ?</h3><h3>Разбор и тактика</h3><p>Начать кислород, ингаляционную бронходилатацию и ранний системный ГКС по схеме для 6–11 лет. Повторно оценивать после вмешательств. Истощение, снижение сознания или «немое лёгкое» требуют немедленной эскалации.</p></section><section id="/protocol/acute-asthma?section=references" class="readable-section"><h2><span>09</span> Клинические рекомендации</h2><ol><li><strong>Acute asthma</strong><p>Royal Children’s Hospital Melbourne · Онлайн-редакция; год публикации не указан</p><a href="https://www.rch.org.au/clinicalguide/guideline_index/asthma_acute/" target="_blank" rel="noreferrer">Открыть рекомендацию</a></li><li><strong>Global Strategy for Asthma Management and Prevention</strong><p>GINA · Strategy Report 2026</p><a href="https://ginasthma.org/wp-content/uploads/2026/05/GINA-2026-Strategy-Report-WMS.pdf" target="_blank" rel="noreferrer">Открыть рекомендацию</a></li><li><strong>Summary Guide for Asthma Management and Prevention</strong><p>GINA · Июль 2026</p><a href="https://ginasthma.org/wp-content/uploads/2026/07/GINA-Summary-Guide-2026-WEB-WMS.pdf" target="_blank" rel="noreferrer">Открыть рекомендацию</a></li><li><strong>Acute asthma (asthma attack)</strong><p>Médecins Sans Frontières · Онлайн-редакция; год публикации не указан</p><a href="https://medicalguidelines.msf.org/en/viewport/CG/english/asthma-attack-acute-asthma-16689575.html" target="_blank" rel="noreferrer">Открыть рекомендацию</a></li></ol></section></article><article id="/protocol/foreign-body" class="readable-article"><a href="#/system/respiratory?age=pediatric">← Все дыхательные темы</a><p class="readable-kicker">ПЕДИАТРИЯ · ДЫХАТЕЛЬНАЯ СИСТЕМА</p><h1>Инородное тело дыхательных путей</h1><p>Airway foreign body</p><nav class="readable-outline" aria-label="Инородное тело дыхательных путей — оглавление"><a href="#/protocol/foreign-body?section=algorithm">Клинический алгоритм</a><a href="#/protocol/foreign-body?section=clinical">Клиническая картина</a><a href="#/protocol/foreign-body?section=severity">Оценка тяжести</a><a href="#/protocol/foreign-body?section=emergency">Неотложная помощь</a><a href="#/protocol/foreign-body?section=escalation">Эскалация помощи</a><a href="#/protocol/foreign-body?section=diagnostics">Экстренная диагностика</a><a href="#/protocol/foreign-body?section=routing">Маршрутизация</a><a href="#/protocol/foreign-body?section=case">Клинический случай</a><a href="#/protocol/foreign-body?section=references">Клинические рекомендации</a></nav><div class="readable-summary"><strong>Главное за минуту</strong><p>Сначала определить эффективность кашля и сохранность сознания. Нормальный снимок и временное исчезновение симптомов не исключают аспирацию.</p></div><p>Подозрение на аспирацию инородного тела. Экстренные манёвры в этой карточке следуют AHA/AAP 2025; их не объединяют с иной последовательностью ERC.</p><section id="/protocol/foreign-body?section=algorithm" class="readable-section"><h2><span>01</span> Клинический алгоритм</h2><div class="readable-scroll"><svg viewBox="0 0 720 1150" role="img" aria-label="Инородное тело дыхательных путей — алгоритм" style="width:100%;min-width:580px;max-width:800px"><defs><marker id="readable-arrow-foreign-body" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0 0L6 3L0 6" fill="none" stroke="#52748c"/></marker></defs><path d="M360 80V112.5H360V140" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-foreign-body)"/><path d="M360 205V250H170V290" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-foreign-body)"/><text x="265" y="240" text-anchor="middle" font-size="11">Да</text><path d="M360 205V250H550V290" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-foreign-body)"/><text x="455" y="240" text-anchor="middle" font-size="11">Нет</text><path d="M170 355V377H25V1028H170V1045" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-foreign-body)"/><path d="M550 355V400H550V440" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-foreign-body)"/><text x="585" y="390" text-anchor="middle" font-size="11">Да</text><path d="M550 355V377H695V878H550V895" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-foreign-body)"/><text x="622.5" y="368" text-anchor="middle" font-size="11">Нет</text><path d="M550 505V550H170V590" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-foreign-body)"/><text x="360" y="540" text-anchor="middle" font-size="11">Да</text><path d="M550 505V550H550V590" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-foreign-body)"/><text x="585" y="540" text-anchor="middle" font-size="11">Нет</text><path d="M170 655V700H360V740" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-foreign-body)"/><path d="M550 655V700H360V740" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-foreign-body)"/><path d="M360 805V927.5H170V1045" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-foreign-body)"/><text x="265" y="917.5" text-anchor="middle" font-size="11">Восстановлено</text><path d="M360 805V852.5H550V895" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-foreign-body)"/><text x="455" y="842.5" text-anchor="middle" font-size="11">Без сознания</text><path d="M550 960V1005H170V1045" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-foreign-body)"/><g><rect x="255" y="20" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="360" y="44" text-anchor="middle" font-size="12">Поперхивание / внезапный</text><text x="360" y="60" text-anchor="middle" font-size="12">кашель / асимметрия</text></g><g><rect x="255" y="145" width="210" height="60" rx="17" fill="#edf5fb" stroke="#467495"/><text x="360" y="169" text-anchor="middle" font-size="12">Кашель</text><text x="360" y="185" text-anchor="middle" font-size="12">эффективен?</text></g><g><rect x="65" y="295" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="170" y="319" text-anchor="middle" font-size="12">Поощрять кашель</text><text x="170" y="335" text-anchor="middle" font-size="12">Наблюдать</text></g><g><rect x="445" y="295" width="210" height="60" rx="17" fill="#edf5fb" stroke="#467495"/><text x="550" y="319" text-anchor="middle" font-size="12">Сознание</text><text x="550" y="335" text-anchor="middle" font-size="12">сохранено?</text></g><g><rect x="445" y="445" width="210" height="60" rx="17" fill="#edf5fb" stroke="#467495"/><text x="550" y="469" text-anchor="middle" font-size="12">Возраст</text><text x="550" y="485" text-anchor="middle" font-size="12">младше 1 года?</text></g><g><rect x="65" y="595" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="170" y="619" text-anchor="middle" font-size="12">До 5 ударов по спине</text><text x="170" y="635" text-anchor="middle" font-size="12">→ до 5 грудных толчков</text></g><g><rect x="445" y="595" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="550" y="619" text-anchor="middle" font-size="12">До 5 ударов по спине</text><text x="550" y="635" text-anchor="middle" font-size="12">→ до 5 абдоминальных</text></g><g><rect x="255" y="745" width="210" height="60" rx="17" fill="#edf5fb" stroke="#467495"/><text x="360" y="769" text-anchor="middle" font-size="12">Дыхание восстановлено /</text><text x="360" y="785" text-anchor="middle" font-size="12">сознание утрачено?</text></g><g><rect x="445" y="900" width="210" height="60" rx="7" fill="#fff0ed" stroke="#467495"/><text x="550" y="924" text-anchor="middle" font-size="12">СЛР, начиная</text><text x="550" y="940" text-anchor="middle" font-size="12">с компрессий — AHA</text></g><g><rect x="65" y="1050" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="170" y="1074" text-anchor="middle" font-size="12">Профильная команда</text><text x="170" y="1090" text-anchor="middle" font-size="12">± бронхоскопия</text></g></svg></div><h3>Действия и условия перехода</h3><ol class="readable-steps"><li><h3>Поперхивание / внезапный кашель / асимметрия</h3><p>Рассматривать и незамеченный эпизод, включая давность в несколько дней.</p><p class="readable-transition">→ Кашель эффективен?</p></li><li><h3>Кашель эффективен?</h3><p>Может ли ребёнок кашлять, плакать/говорить и проводить воздух?</p><p class="readable-transition">Да → Поощрять кашель Наблюдать<br>Нет → Сознание сохранено?</p></li><li><h3>Поощрять кашель Наблюдать</h3><p>Не выполнять манёвры при эффективном кашле. Профильная оценка, если подозрение сохраняется.</p><p class="readable-transition">→ Профильная команда ± бронхоскопия</p></li><li><h3>Сознание сохранено?</h3><p>Активировать экстренную помощь. Выбран алгоритм AHA/AAP 2025.</p><p class="readable-transition">Да → Возраст младше 1 года?<br>Нет → СЛР, начиная с компрессий — AHA</p></li><li><h3>Возраст младше 1 года?</h3><p>Различаются типы толчков; абдоминальные толчки младенцу не выполняют.</p><p class="readable-transition">Да → До 5 ударов по спине → до 5 грудных толчков<br>Нет → До 5 ударов по спине → до 5 абдоминальных</p></li><li><h3>До 5 ударов по спине → до 5 грудных толчков</h3><p>Голова ниже туловища с поддержкой. После каждого действия оценивать эффект. Повторять до устранения обструкции или утраты сознания.</p><p class="readable-transition">→ Дыхание восстановлено / сознание утрачено?</p></li><li><h3>До 5 ударов по спине → до 5 абдоминальных</h3><p>Повторять, оценивая эффект каждого действия. Прекратить при восстановлении эффективного кашля/дыхания.</p><p class="readable-transition">→ Дыхание восстановлено / сознание утрачено?</p></li><li><h3>Дыхание восстановлено / сознание утрачено?</h3><p>При восстановлении — наблюдение и медицинская оценка; при утрате сознания — ветвь СЛР.</p><p class="readable-transition">Восстановлено → Профильная команда ± бронхоскопия<br>Без сознания → СЛР, начиная с компрессий — AHA</p></li><li><h3>СЛР, начиная с компрессий — AHA</h3><p>При тяжёлой обструкции и утрате сознания AHA не рекомендует задержку на проверку пульса. Перед вдохами удалить только видимый предмет; СЛР с вдохами по педиатрическому алгоритму.</p><p class="readable-transition">→ Профильная команда ± бронхоскопия</p></li><li><h3>Профильная команда ± бронхоскопия</h3><p>Нормальный снимок не исключает аспирацию. Срочность определяется состоянием; не ждать условных 24–48 часов при ухудшении.</p></li></ol></section><section id="/protocol/foreign-body?section=clinical" class="readable-section"><h2><span>02</span> Клиническая картина</h2><p>Подозревать аспирацию после внезапного кашля или поперхивания при еде либо игре. Возможны стридор, локальный свист, ослабление дыхания с одной стороны. После скрытого периода могут возникать стойкий кашель или повторная пневмония.</p><div class="readable-block readable-danger"><h3>Тяжёлая обструкция</h3><p>Ребёнок не может издать звук, эффективно кашлять или дышать; возможны цианоз и утрата сознания. Немедленно активировать помощь и перейти к возрастным приёмам в таблице. Устранение обструкции не задерживать ради снимка.</p></div><div class="readable-block "><h3>Внезапное улучшение не исключает инородное тело</h3><p>После поперхивания объект может переместиться в бронх: кашель уменьшается, но сохраняются локальное ослабление дыхания, односторонний свист или поздняя пневмония. При клиническом подозрении нужна профильная оценка даже при нормальном осмотре/рентгенограмме.</p></div><figure class="readable-image-slot"><strong>Место для изображения 1</strong><p>Возрастные приёмы помощи при инородном теле</p></figure></section><section id="/protocol/foreign-body?section=severity" class="readable-section"><h2><span>03</span> Оценка тяжести</h2><div class="readable-table"><h3>Клинические признаки тяжести</h3><div class="readable-scroll" tabindex="0"><table><thead><tr><th scope="col">Состояние</th><th scope="col">Ориентиры</th></tr></thead><tbody><tr><th scope="row">Эффективный кашель</th><td>Голос и поступление воздуха сохранены. Наблюдать и поощрять кашель.</td></tr><tr><th scope="row">Тяжёлая обструкция</th><td>Беззвучный кашель, невозможность говорить или плакать. При сохранённом сознании начать возрастные приёмы.</td></tr><tr><th scope="row">Утрата сознания</th><td>Начать педиатрическую СЛР и вызвать помощь.</td></tr><tr><th scope="row">Вероятная аспирация при стабильном дыхании</th><td>Наблюдение и срочная профильная оценка.</td></tr></tbody></table></div></div></section><section id="/protocol/foreign-body?section=emergency" class="readable-section"><h2><span>04</span> Неотложная помощь</h2><div class="readable-block "><h3>Кашель, сознание и симметрия дыхания</h3><p>A/B: может ли кашлять, говорить/плакать, есть ли воздушный поток; оценить стридор и обе половины грудной клетки. D: сохранность сознания. При эффективном кашле не выполнять удары/толчки рутинно; наблюдать и быть готовым к ухудшению.</p></div><div class="readable-block "><h3>Конечная помощь — восстановить проходимость</h3><p>Манёвры при тяжёлой обструкции приведены отдельно по возрасту и сознанию. После восстановления дыхания продолжать наблюдение и оценить вероятность оставшегося предмета. Слепые пальцевые попытки не выполнять.</p></div><div class="readable-block "><h3>Бронхоскопия и лекарственные назначения</h3><p>При сохраняющемся подозрении окончательную тактику определяет команда, способная выполнить детскую бронхоскопию и анестезиологическое обеспечение. Бронходилататоры, ГКС и антибиотики не устраняют механический объект; сопутствующие осложнения лечатся по отдельным показаниям.</p></div><div class="readable-table"><h3>Экстренная помощь при тяжёлой обструкции — AHA/AAP 2025</h3><div class="readable-scroll" tabindex="0"><table><thead><tr><th scope="col">Состояние</th><th scope="col">Действия</th><th scope="col">Прекращение / ограничение</th></tr></thead><tbody><tr><th scope="row">Эффективный кашель</th><td>Поощрять кашель, наблюдать</td><td>Не выполнять манёвры тяжёлой обструкции</td></tr><tr><th scope="row">В сознании, младше 1 года</th><td>До 5 ударов по спине → до 5 толчков в грудную клетку</td><td>Повторять до восстановления дыхания или потери сознания; без абдоминальных толчков</td></tr><tr><th scope="row">В сознании, ≥1 года</th><td>До 5 ударов по спине → до 5 абдоминальных толчков</td><td>Оценивать эффект каждого действия; остановиться при устранении обструкции</td></tr><tr><th scope="row">Без сознания при тяжёлой обструкции</th><td>СЛР с компрессий; перед вдохами удалить только видимый предмет</td><td>Не задерживать СЛР проверкой пульса; без слепого пальцевого обследования</td></tr></tbody></table></div><p>Профессиональное обучение и возрастной алгоритм СЛР обязательны. Это выбранная последовательность AHA; ERC начинает с пяти спасательных вдохов, что отражено в замечаниях.</p></div><h3>Повторная оценка</h3><p>После каждого цикла оценить кашель, голос, дыхание и сознание. После исчезновения симптомов проверить остаточные признаки. При убедительном анамнезе нужен дальнейший осмотр.</p></section><section id="/protocol/foreign-body?section=escalation" class="readable-section"><h2><span>05</span> Эскалация помощи</h2><p>При нарастающей обструкции или нарушении сознания немедленно вызвать реанимационную команду. При сохраняющемся подозрении на объект решить вопрос о бронхоскопии с профильной командой.</p></section><section id="/protocol/foreign-body?section=diagnostics" class="readable-section"><h2><span>06</span> Экстренная диагностика</h2><div class="readable-block "><h3>Подтверждение при стабильном дыхании</h3><p>Уточнить эпизод при еде/игре, его давность и предмет. Рентгенограмма может показать асимметрию вентиляции, ателектаз или осложнения, но большинство предметов рентгенонеконтрастны. При средней/высокой вероятности — ранняя консультация ЛОР/респираторной команды для бронхоскопии.</p></div><div class="readable-block "><h3>КТ — избирательно, без задержки удаления</h3><p>RCH, обновление сентября 2026: низкодозная КТ возможна у стабильного ребёнка при неясной вероятности и неубедительном снимке после обсуждения со специалистом. При угрозе дыхательным путям или ясных показаниях к срочной бронхоскопии КТ не должна задерживать вмешательство.</p></div><div class="readable-table"><h3>Механизмы и дифференциальная диагностика</h3><div class="readable-scroll" tabindex="0"><table><thead><tr><th scope="col">Состояние</th><th scope="col">Ориентиры</th></tr></thead><tbody><tr><th scope="row">Анафилаксия</th><td>Связь с аллергеном, отёк, кожные или гемодинамические проявления.</td></tr><tr><th scope="row">Круп</th><td>Лающий кашель и респираторный продром.</td></tr><tr><th scope="row">Пневмоторакс</th><td>Внезапная асимметрия дыхания, боль или нарушение гемодинамики.</td></tr></tbody></table></div></div><figure class="readable-image-slot"><strong>Место для изображения 2</strong><p>Непрямые рентгенологические признаки аспирации</p></figure></section><section id="/protocol/foreign-body?section=routing" class="readable-section"><h2><span>07</span> Маршрутизация</h2><div class="readable-block "><h3>До удаления / исключения</h3><p>Наблюдать за дыханием и сознанием, поскольку смещение предмета может вызвать внезапную обструкцию. При нестабильности — реанимационная зона и ранний перевод с поддержкой дыхания; при отсутствии возможностей детской бронхоскопии заранее согласовать профильный центр.</p></div><div class="readable-block "><h3>После вмешательства</h3><p>Повторно оценить дыхание, сатурацию, стридор, асимметрию и осложнения. Выписка — после решения профильной команды и устойчивой стабильности; сохраняющееся клиническое подозрение требует дальнейшего обследования, а не выписки по одному нормальному снимку.</p></div></section><section id="/protocol/foreign-body?section=case" class="readable-section"><h2><span>08</span> Клинический случай</h2><h3>Учебный сценарий</h3><p>Ребёнок 2 лет закашлялся во время еды. Сейчас спокоен, справа дыхание ослаблено. На рентгенограмме объект не виден.</p><h3>Исключает ли нормальный снимок аспирацию?</h3><h3>Разбор и тактика</h3><p>Убедительный эпизод и односторонний признак сохраняют подозрение. Нужны наблюдение и срочное обсуждение бронхоскопии. При переходе к тяжёлой обструкции действовать по возрастной ветви алгоритма.</p></section><section id="/protocol/foreign-body?section=references" class="readable-section"><h2><span>09</span> Клинические рекомендации</h2><ol><li><strong>Part 6: Pediatric Basic Life Support</strong><p>AHA / AAP · Guidelines for CPR and ECC 2025</p><a href="https://cpr.heart.org/en/resuscitation-science/cpr-and-ecc-guidelines/pediatric-basic-life-support" target="_blank" rel="noreferrer">Открыть рекомендацию</a></li><li><strong>Foreign body inhalation</strong><p>Royal Children’s Hospital Melbourne · Обновление сентябрь 2026</p><a href="https://www.rch.org.au/clinicalguide/guideline_index/Foreign_body_inhalation/" target="_blank" rel="noreferrer">Открыть рекомендацию</a></li><li><strong>European Resuscitation Council Guidelines 2025: Paediatric Life Support</strong><p>European Resuscitation Council · Resuscitation 215 Suppl 1:110767</p><a href="https://www.erc.edu/media/03xnpjmj/gl2025-09-pls-e.pdf" target="_blank" rel="noreferrer">Открыть рекомендацию</a></li></ol></section></article><article id="/protocol/central-hypoventilation" class="readable-article"><a href="#/system/respiratory?age=pediatric">← Все дыхательные темы</a><p class="readable-kicker">ПЕДИАТРИЯ · ДЫХАТЕЛЬНАЯ СИСТЕМА</p><h1>Центральная гиповентиляция</h1><p>Central hypoventilation</p><nav class="readable-outline" aria-label="Центральная гиповентиляция — оглавление"><a href="#/protocol/central-hypoventilation?section=algorithm">Клинический алгоритм</a><a href="#/protocol/central-hypoventilation?section=clinical">Клиническая картина</a><a href="#/protocol/central-hypoventilation?section=severity">Оценка тяжести</a><a href="#/protocol/central-hypoventilation?section=emergency">Неотложная помощь</a><a href="#/protocol/central-hypoventilation?section=escalation">Эскалация помощи</a><a href="#/protocol/central-hypoventilation?section=diagnostics">Экстренная диагностика</a><a href="#/protocol/central-hypoventilation?section=routing">Маршрутизация</a><a href="#/protocol/central-hypoventilation?section=case">Клинический случай</a><a href="#/protocol/central-hypoventilation?section=references">Клинические рекомендации</a></nav><div class="readable-summary"><strong>Главное за минуту</strong><p>При неэффективном дыхании восстановить вентиляцию. Кислород может улучшить SpO₂, сохраняя опасную гиперкапнию.</p></div><p>Острое ухудшение вентиляции у ребёнка, включая известный CCHS. Реанимация новорождённого при рождении и подбор домашнего вентилятора — отдельные задачи.</p><section id="/protocol/central-hypoventilation?section=algorithm" class="readable-section"><h2><span>01</span> Клинический алгоритм</h2><div class="readable-scroll"><svg viewBox="0 0 720 845" role="img" aria-label="Центральная гиповентиляция — алгоритм" style="width:100%;min-width:580px;max-width:800px"><defs><marker id="readable-arrow-central-hypoventilation" markerWidth="8" markerHeight="8" refX="6" refY="3" orient="auto"><path d="M0 0L6 3L0 6" fill="none" stroke="#52748c"/></marker></defs><path d="M360 80V112.5H360V140" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-central-hypoventilation)"/><path d="M360 205V250H170V290" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-central-hypoventilation)"/><text x="265" y="240" text-anchor="middle" font-size="11">Да</text><path d="M360 205V250H550V290" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-central-hypoventilation)"/><text x="455" y="240" text-anchor="middle" font-size="11">Нет</text><path d="M170 355V377H25V573H550V590" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-central-hypoventilation)"/><path d="M550 355V400H550V440" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-central-hypoventilation)"/><text x="585" y="390" text-anchor="middle" font-size="11">Да</text><path d="M550 355V400H170V440" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-central-hypoventilation)"/><text x="360" y="390" text-anchor="middle" font-size="11">Нет / сомнение</text><path d="M550 505V550H550V590" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-central-hypoventilation)"/><path d="M170 505V625H170V740" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-central-hypoventilation)"/><path d="M550 655V700H550V740" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-central-hypoventilation)"/><text x="585" y="690" text-anchor="middle" font-size="11">Да</text><path d="M550 655V700H170V740" fill="none" stroke="#52748c" marker-end="url(#readable-arrow-central-hypoventilation)"/><text x="360" y="690" text-anchor="middle" font-size="11">Нет / хуже</text><g><rect x="255" y="20" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="360" y="44" text-anchor="middle" font-size="12">Редкое / поверхностное</text><text x="360" y="60" text-anchor="middle" font-size="12">дыхание ± CCHS</text></g><g><rect x="255" y="145" width="210" height="60" rx="17" fill="#edf5fb" stroke="#467495"/><text x="360" y="169" text-anchor="middle" font-size="12">Дыхание</text><text x="360" y="185" text-anchor="middle" font-size="12">эффективно?</text></g><g><rect x="65" y="295" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="170" y="319" text-anchor="middle" font-size="12">Мониторинг + поиск</text><text x="170" y="335" text-anchor="middle" font-size="12">триггера / сбоя</text></g><g><rect x="445" y="295" width="210" height="60" rx="17" fill="#edf5fb" stroke="#467495"/><text x="550" y="319" text-anchor="middle" font-size="12">Пульс уверенно</text><text x="550" y="335" text-anchor="middle" font-size="12">определяется?</text></g><g><rect x="445" y="445" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="550" y="469" text-anchor="middle" font-size="12">BVM с кислородом</text><text x="550" y="485" text-anchor="middle" font-size="12">20–30 вдохов/мин</text></g><g><rect x="65" y="445" width="210" height="60" rx="7" fill="#fff0ed" stroke="#467495"/><text x="170" y="469" text-anchor="middle" font-size="12">Педиатрическая СЛР</text><text x="170" y="485" text-anchor="middle" font-size="12">и реанимационная команда</text></g><g><rect x="445" y="595" width="210" height="60" rx="17" fill="#edf5fb" stroke="#467495"/><text x="550" y="619" text-anchor="middle" font-size="12">Вентиляция и состояние</text><text x="550" y="635" text-anchor="middle" font-size="12">улучшаются?</text></g><g><rect x="65" y="745" width="210" height="60" rx="7" fill="#fff0ed" stroke="#467495"/><text x="170" y="769" text-anchor="middle" font-size="12">Анестезиолог + ОРИТ</text><text x="170" y="785" text-anchor="middle" font-size="12">Расширенный airway</text></g><g><rect x="445" y="745" width="210" height="60" rx="7" fill="#edf5fb" stroke="#467495"/><text x="550" y="769" text-anchor="middle" font-size="12">Наблюдение / стационар</text><text x="550" y="785" text-anchor="middle" font-size="12">согласованная вентиляция</text></g></svg></div><h3>Действия и условия перехода</h3><ol class="readable-steps"><li><h3>Редкое / поверхностное дыхание ± CCHS</h3><p>Параллельно оценить сознание, пульс, грудную экскурсию и доступный CO₂.</p><p class="readable-transition">→ Дыхание эффективно?</p></li><li><h3>Дыхание эффективно?</h3><p>Нормальная SpO₂ на кислороде не исключает гиповентиляцию.</p><p class="readable-transition">Да → Мониторинг + поиск триггера / сбоя<br>Нет → Пульс уверенно определяется?</p></li><li><h3>Мониторинг + поиск триггера / сбоя</h3><p>Восстановить индивидуальный план; при ухудшении немедленно перейти к поддержке вентиляции.</p><p class="readable-transition">→ Вентиляция и состояние улучшаются?</p></li><li><h3>Пульс уверенно определяется?</h3><p>Проверка обученным специалистом не должна задерживать реанимацию.</p><p class="readable-transition">Да → BVM с кислородом 20–30 вдохов/мин<br>Нет / сомнение → Педиатрическая СЛР и реанимационная команда</p></li><li><h3>BVM с кислородом 20–30 вдохов/мин</h3><p>AHA/AAP 2025 для младенца/ребёнка с пульсом и недостаточным дыханием: вдох каждые 2–3 с до видимого подъёма грудной клетки; избегать гипервентиляции.</p><p class="readable-transition">→ Вентиляция и состояние улучшаются?</p></li><li><h3>Педиатрическая СЛР и реанимационная команда</h3><p>При отсутствии пульса либо ЧСС &lt;60/мин с плохой перфузией несмотря на эффективную оксигенацию/вентиляцию — действовать по педиатрическому BLS/PALS.</p><p class="readable-transition">→ Анестезиолог + ОРИТ Расширенный airway</p></li><li><h3>Вентиляция и состояние улучшаются?</h3><p>Контроль сразу после вмешательства и непрерывно при нестабильности. Проверять герметичность, проходимость, аппарат и CO₂.</p><p class="readable-transition">Да → Наблюдение / стационар согласованная вентиляция<br>Нет / хуже → Анестезиолог + ОРИТ Расширенный airway</p></li><li><h3>Анестезиолог + ОРИТ Расширенный airway</h3><p>Неэффективная BVM или незащищённые дыхательные пути требуют экспертной эскалации. Не задерживать ради анализов.</p></li><li><h3>Наблюдение / стационар согласованная вентиляция</h3><p>Выписка только при возврате к исходному состоянию и безопасном индивидуальном плане.</p></li></ol></section><section id="/protocol/central-hypoventilation?section=clinical" class="readable-section"><h2><span>02</span> Клиническая картина</h2><p>Недостаточный дыхательный драйв проявляется редким или поверхностным дыханием, сонливостью и гиперкапнией без выраженных втяжений. При CCHS важно выяснить обычный режим вентиляции, возможную инфекцию и состояние оборудования.</p><div class="readable-block readable-danger"><h3>Апноэ / неэффективное дыхание — немедленная помощь</h3><p>Апноэ, гаспинг, плохие экскурсии грудной клетки, угнетение сознания, цианоз или брадикардия требуют немедленного вызова команды. При наличии пульса и недостаточном дыхании начать эффективную вентиляцию мешком-маской с кислородом, не ожидая газов крови.</p></div><div class="readable-block readable-danger"><h3>SpO₂ не измеряет вентиляцию</h3><p>При CCHS дыхание может выглядеть спокойным, а CO₂ — нарастать. Кислород без вентиляционной поддержки способен скрыть гипоксемию и ухудшить гиповентиляцию. Оценивать дыхательные движения, сознание и CO₂ наряду с сатурацией.</p></div><figure class="readable-image-slot"><strong>Место для изображения 1</strong><p>Схема вентиляционной поддержки и контроля CO₂</p></figure></section><section id="/protocol/central-hypoventilation?section=severity" class="readable-section"><h2><span>03</span> Оценка тяжести</h2><div class="readable-table"><h3>Клинические признаки тяжести</h3><div class="readable-scroll" tabindex="0"><table><thead><tr><th scope="col">Состояние</th><th scope="col">Ориентиры</th></tr></thead><tbody><tr><th scope="row">Близко к исходному состоянию</th><td>Обычное сознание и эффективная индивидуальная поддержка.</td></tr><tr><th scope="row">Недостаточная вентиляция</th><td>Редкие или мелкие вдохи, сонливость, рост CO₂.</td></tr><tr><th scope="row">Декомпенсация</th><td>Апноэ, гаспинг, нарушенное сознание, цианоз или брадикардия.</td></tr></tbody></table></div></div></section><section id="/protocol/central-hypoventilation?section=emergency" class="readable-section"><h2><span>04</span> Неотложная помощь</h2><div class="readable-block "><h3>B/D и индивидуальный исходный уровень</h3><p>Уточнить обычный режим поддержки, зависимость от неё во сне/бодрствовании, триггер, недавнюю седацию и работу аппарата. Проверка питания/контура/канюли идёт параллельно с поддержкой дыхания, а не вместо неё. Учитывать персональный план пациента.</p></div><div class="readable-block "><h3>Восстановить эффективную вентиляцию</h3><p>Позиционировать дыхательные пути, обеспечить герметичность маски и видимый подъём грудной клетки; при необходимости двухоператорная техника и обученная команда. Неэффективная BVM, утрата защиты дыхательных путей или длительная потребность в поддержке требуют анестезиолога/ОРИТ и оценки расширенного обеспечения дыхательных путей.</p></div><div class="readable-block "><h3>Известный CCHS</h3><p>Восстановить назначенную поддержку, наблюдать CO₂ и сатурацию. Во время инфекции или после анестезии поддержка может требоваться и в бодрствовании. Настройки и длительность согласовать с ведущей командой. CPAP без обеспечения вентиляции не заменяет назначенную поддержку CCHS.</p></div><div class="readable-block "><h3>Лекарства по причине</h3><p>Специфическое рутинное лекарство, заменяющее вентиляцию при CCHS, не установлено. При вероятном опиоидном угнетении антидот рассматривают по токсикологическому протоколу одновременно с вентиляцией. Универсальные дозы седативных, стимуляторов дыхания или параметры ИВЛ сюда не перенесены.</p></div><div class="readable-table"><h3>Не смешивать экстренную вентиляцию и цели хронического CCHS</h3><div class="readable-scroll" tabindex="0"><table><thead><tr><th scope="col">Контекст</th><th scope="col">Ориентир</th><th scope="col">Граница применения</th></tr></thead><tbody><tr><th scope="row">Пульс есть, дыхание недостаточное</th><td>BVM: 20–30 вдохов/мин; 1 вдох каждые 2–3 секунды</td><td>AHA/AAP 2025; младенцы/дети, не реанимация при рождении</td></tr><tr><th scope="row">Адекватность назначенной поддержки CCHS</th><td>SpO₂ ≥95%; PCO₂ обычно 35–45 мм рт. ст.</td><td>Профильное руководство 2020; индивидуализировать, не ждать цифр при декомпенсации</td></tr><tr><th scope="row">Недостаточная вентиляция</th><td>Кислород добавляют к поддержке по ситуации</td><td>Кислород в одиночку не устраняет задержку CO₂</td></tr></tbody></table></div></div><h3>Повторная оценка</h3><p>Контролировать подъём грудной клетки, пульс, сознание, SpO₂ и доступный мониторинг CO₂. Проверить маску, контур, аппарат и проходимость дыхательных путей параллельно вентиляции.</p></section><section id="/protocol/central-hypoventilation?section=escalation" class="readable-section"><h2><span>05</span> Эскалация помощи</h2><p>При неэффективной вентиляции мешком с маской, незащищённых дыхательных путях или сохраняющемся угнетении сознания вызвать анестезиолога и ОРИТ. Кислород назначают в составе поддержки вентиляции по состоянию.</p></section><section id="/protocol/central-hypoventilation?section=diagnostics" class="readable-section"><h2><span>06</span> Экстренная диагностика</h2><div class="readable-block "><h3>Что меняет ближайшую тактику</h3><p>Мониторировать дыхание, SpO₂, ЭКГ/пульс и гемодинамику; CO₂ — доступным капнографическим/транскутанным методом. Газы крови помогают оценить гиперкапнию и ацидоз после начала поддержки. Уровень сознания и эффективность вентиляции важнее ожидания результата.</p></div><div class="readable-block "><h3>Не считать всякую гиповентиляцию CCHS</h3><p>Рассмотреть лекарственное угнетение, поражение ЦНС, обструкцию, нервно-мышечную патологию и метаболическую причину. CCHS требует профильного обследования, включая PHOX2B/исследование сна по показаниям; генетический тест не является первичным неотложным исследованием.</p></div><div class="readable-table"><h3>Механизмы и дифференциальная диагностика</h3><div class="readable-scroll" tabindex="0"><table><thead><tr><th scope="col">Состояние</th><th scope="col">Ориентиры</th></tr></thead><tbody><tr><th scope="row">Опиоиды / седативные</th><td>Лекарственный анамнез, угнетение дыхания.</td></tr><tr><th scope="row">Механическая проблема</th><td>Обструкция дыхательных путей, трахеостомы или контура.</td></tr><tr><th scope="row">Инфекция / метаболическое нарушение</th><td>Признаки инфекции, нарушения перфузии или гликемии.</td></tr></tbody></table></div></div><figure class="readable-image-slot"><strong>Место для изображения 2</strong><p>Проверка маски, контура и аппарата</p></figure></section><section id="/protocol/central-hypoventilation?section=routing" class="readable-section"><h2><span>07</span> Маршрутизация</h2><div class="readable-block "><h3>Ранняя ОРИТ</h3><p>Повторные апноэ, нарушенное сознание/перфузия, необходимость ручной вентиляции или расширенного обеспечения дыхательных путей — срочная помощь ОРИТ. Новый эпизод у известного пациента с CCHS требует оценки причины и безопасности назначенного режима.</p></div><div class="readable-block "><h3>Условия завершения наблюдения</h3><p>Возврат к индивидуальному исходному состоянию, стабильные оксигенация и вентиляция на согласованном режиме, понятная причина эпизода и работающий план дома. Проверить основной/резервный аппарат, обучение ухаживающих и связь с командой CCHS; длительность наблюдения индивидуальна.</p></div></section><section id="/protocol/central-hypoventilation?section=case" class="readable-section"><h2><span>08</span> Клинический случай</h2><h3>Учебный сценарий</h3><p>Ребёнок 4 лет с CCHS получает вентиляцию во сне. На фоне инфекции возникли сонливость и редкое поверхностное дыхание. SpO₂ 88%, аппарат не подключён.</p><h3>Что сделать до получения газов крови?</h3><h3>Разбор и тактика</h3><p>Вызвать команду и немедленно восстановить вентиляцию. При сохранённом пульсе и неэффективном дыхании начать вентиляцию мешком с маской, контролируя подъём грудной клетки. Следить за CO₂, поскольку улучшение SpO₂ на кислороде не показывает устранение гиповентиляции.</p></section><section id="/protocol/central-hypoventilation?section=references" class="readable-section"><h2><span>09</span> Клинические рекомендации</h2><ol><li><strong>Guidelines for diagnosis and management of congenital central hypoventilation syndrome</strong><p>Trang H et al. / Orphanet Journal of Rare Diseases · 15:252; DOI 10.1186/s13023-020-01460-2</p><a href="https://link.springer.com/article/10.1186/s13023-020-01460-2" target="_blank" rel="noreferrer">Открыть рекомендацию</a></li><li><strong>Part 6: Pediatric Basic Life Support</strong><p>AHA / AAP · Guidelines for CPR and ECC 2025</p><a href="https://cpr.heart.org/en/resuscitation-science/cpr-and-ecc-guidelines/pediatric-basic-life-support" target="_blank" rel="noreferrer">Открыть рекомендацию</a></li></ol></section></article><section id="/protocol/pediatric-bls" class="readable-article"><a href="#/system/respiratory?age=pediatric">← К темам</a><h1>Paediatric Basic Life Support</h1><p>Resuscitation Council (UK) · Рекомендации 2005 года</p><p>Архивная редакция 2005 года. Документ сохранён для изучения и сопоставления; его алгоритмы и дозировки не следует использовать как действующие рекомендации.</p><object data="data:application/pdf;base64," type="application/pdf" width="100%" height="700"><p>Для встроенного PDF нужен браузер с поддержкой просмотра PDF.</p></object></section><section id="/protocol/pals" class="readable-article"><a href="#/system/respiratory?age=pediatric">← К темам</a><h1>PALS Provider Handbook</h1><p>Satori Continuum Publishing · Версия 2026.01 · на обложке — стандарты 2025</p><p>Учебное пособие стороннего издателя, а не официальное издание AHA. На обложке указаны стандарты 2025 года; в тексте встречаются ссылки на редакцию 2020. Независимая медицинская проверка этого пособия в проекте не проводилась.</p><object data="data:application/pdf;base64,